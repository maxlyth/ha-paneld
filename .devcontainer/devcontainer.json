{
  "name": "ha-paneld Android build",
  "build": { "dockerfile": "Dockerfile" },
  "remoteEnv": {
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "fwcd.kotlin",
        "vscjava.vscode-gradle"
      ]
    }
  },
  // Warms the Gradle wrapper so the first build is faster; harmless offline.
  // adb is on PATH — `adb connect <panel-ip>:5555 && adb install -r <apk>` reaches panels over the network.
  // Then runs a local, gitignored per-host setup hook if present (no-op for normal checkouts).
  "postCreateCommand": "./gradlew --version || true; [ -x .devcontainer/post-create.local.sh ] && .devcontainer/post-create.local.sh || true",
  // Don't connect the window/terminals/extensions until postCreateCommand finishes — otherwise the
  // env (PATH, CLIs, ~ links) loads half-built and needs manual window reloads. Default is
  // updateContentCommand, which runs before postCreate.
  "waitFor": "postCreateCommand"
}
