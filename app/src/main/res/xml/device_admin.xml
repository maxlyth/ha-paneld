<?xml version="1.0" encoding="utf-8"?>
<!-- Device-admin policy for ha-paneld. Only force-lock is requested — the single policy needed
     for DevicePolicyManager.lockNow() to sleep the screen. No wipe, no password policy. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
