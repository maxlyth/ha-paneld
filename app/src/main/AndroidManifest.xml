<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- TTS playback volume (STREAM_MUSIC via AudioManager). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- JmDNS multicast advertise requires holding a WifiManager.MulticastLock. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Auto-start the listener after a panel reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 11+ package visibility: ha-paneld must see/resolve the dashboard app (Companion) and
         other launchers to reload them and offer launcher/home navigation. Sideloaded panel agent,
         not a Play app, so the broad query permission is appropriate. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- Screen brightness via Settings.System (granted at provisioning: appops set WRITE_SETTINGS). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- Soft navigation-bar overlay (TYPE_APPLICATION_OVERLAY) for panels whose firmware hides the
         native navbar. Not granted by default on the panels; NavbarController grants it via root appops. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".HaPaneldApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AppCompat.DayNight">

        <!-- Official Shizuku Binder hand-off. The signature-level permission prevents ordinary apps
             from calling this exported provider; ha-paneld never opens an ADB or network listener. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConfigActivity"
            android:exported="false"
            android:label="ha-paneld configuration" />

        <!-- Built-in dashboard renderer (experimental). exported so the privileged am start path can
             open it; singleTask so a repeat launch reaches the running instance (onNewIntent = reload)
             instead of stacking a second WebView. Declares CATEGORY_HOME (like AdminLauncherActivity) so
             ensureDashboardHome can set it as the default home when dashboard_package=builtin — boots to
             the dashboard + Home returns to it. NOT CATEGORY_LAUNCHER (a second MAIN/LAUNCHER activity
             makes the app's front door resolve to the chooser); MainActivity stays the sole launcher icon. -->
        <activity
            android:name=".DashboardActivity"
            android:exported="true"
            android:label="HA dashboard"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <!-- configChanges: handle rotation + day/night (uiMode) in-place instead of letting Android
                 destroy/recreate the activity — a recreation reloads the whole dashboard, so without this
                 an always-on panel that auto-darkens reloads every dusk and dawn. We do our own force-dark,
                 so the system recreation buys nothing. (Same set the HA Companion uses.) -->
            <!-- Selectable / assignable HOME so it can become the boot-to dashboard home. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Admin app drawer. Reachable three ways: the navbar Launcher button (privileged am start),
             as a selectable/last-resort HOME app (Settings -> Home), and the HA/:8888 trigger. It does
             NOT carry CATEGORY_LAUNCHER on purpose — a second MAIN/LAUNCHER activity makes the package's
             front-door launch ambiguous (Android resolves it to the system chooser instead of
             MainActivity, hiding the QR standing screen). MainActivity stays the sole launcher icon.
             It does NOT become the default home either — Companion stays default and keeps booting to
             the dashboard; this is only a selectable/fallback home. exported so the privileged am start
             path can open it. -->
        <activity
            android:name=".AdminLauncherActivity"
            android:exported="true"
            android:label="Panel admin"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.AppCompat.DayNight">
            <!-- Selectable / last-resort HOME. Companion remains the default home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".PaneldService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Android 14+ requires declaring the specialUse subtype. ha-paneld is a
                 wall-panel hardware agent: a persistent on-LAN command/MQTT listener that
                 has no analogue in the predefined foreground-service types. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ha-paneld persistent HTTP/MQTT listener for Home Assistant panel hardware control" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Optional hardware-button capture. Enabled at provisioning:
             settings put secure enabled_accessibility_services <pkg>/.input.PanelAccessibilityService -->
        <service
            android:name=".input.PanelAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

    </application>

</manifest>
