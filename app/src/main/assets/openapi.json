{
  "openapi": "3.0.3",
  "info": {
    "title": "ha-paneld",
    "version": "0.8.5",
    "description": "Local HTTP control API for a Home Assistant wall-panel agent. Plain HTTP on the LAN, no auth. The canonical machine API lives under /api/v1; the pre-0.8.5 flat paths respond 308 Permanent Redirect to their /api/v1 homes (method + body preserved). Exceptions: GET /health and POST /play are also served directly at the root — they are the external contract endpoints called by plain curl from automations and monitors."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/health": { "get": { "summary": "Liveness probe + version + panel id + build token (also at /api/v1/health)", "tags": ["status"], "responses": { "200": { "description": "OK" } } } },
    "/play": {
      "post": { "summary": "Play audio / TTS from a URL; newest request replaces current playback (also at /api/v1/play)", "tags": ["media"],
        "requestBody": { "content": { "text/plain": { "schema": { "type": "string", "description": "a raw URL, or {\"url\":\"https://…\"}" } } } },
        "responses": { "200": { "description": "playing" }, "400": { "description": "no-url" }, "503": { "description": "stopping" } } }
    },
    "/api/v1/status": { "get": { "summary": "Panel-health warnings + capability matrix as JSON", "tags": ["status"], "responses": { "200": { "description": "{warnings:[html], capabilities:[{name,note,color}]}" } } } },
    "/api/v1/profiles": {
      "get": { "summary": "List immutable bundled/local profile revisions and current activation state", "tags": ["profiles"], "responses": { "200": { "description": "Catalog revision, selection, activation/LKG state, issues and profile summaries" }, "503": { "description": "Profile repository not wired" } } }
    },
    "/api/v1/profiles/schema": {
      "get": { "summary": "Profile schema metadata for authoring and validation", "tags": ["profiles"], "responses": { "200": { "description": "Schema version, YAML byte bound and typed field descriptors" } } }
    },
    "/api/v1/profiles/drivers": {
      "get": { "summary": "Compiled driver catalogue available to declarative profiles", "tags": ["profiles"], "responses": { "200": { "description": "Typed driver descriptors including privileged classification" } } }
    },
    "/api/v1/profiles/template": {
      "get": { "summary": "Download a new unsaved YAML profile template", "tags": ["profiles"], "responses": { "200": { "description": "application/yaml" }, "501": { "description": "Template provider unavailable" } } }
    },
    "/api/v1/profiles/device-draft": {
      "get": { "summary": "Download a read-only Generic draft from passive Android facts; unknown hardware remains TODO", "tags": ["profiles"], "responses": { "200": { "description": "application/yaml" }, "501": { "description": "Generic is not active or the passive draft provider is unavailable" } } }
    },
    "/api/v1/profiles/report": {
      "get": { "summary": "Latest sanitized passive profile report", "tags": ["profiles"], "responses": { "200": { "description": "Allowlisted device facts, observations and issues" }, "404": { "description": "No report available" } } }
    },
    "/api/v1/profiles/{id}/revisions/{revision}": {
      "get": { "summary": "Export one exact immutable YAML revision", "tags": ["profiles"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "revision", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
        ], "responses": { "200": { "description": "application/yaml attachment" }, "404": { "description": "Revision not found" } } }
    },
    "/api/v1/profiles/preview": {
      "post": { "summary": "Parse, validate and semantically compare YAML without saving or activating", "tags": ["profiles"],
        "requestBody": { "required": true, "content": { "application/yaml": { "schema": { "type": "string", "description": "UTF-8 YAML; request body limited to 131072 bytes" } } } },
        "responses": { "200": { "description": "Compatibility, safe diagnostics, semantic diff, exact content hash and short-lived preview token" }, "413": { "description": "YAML too large" }, "415": { "description": "YAML content type required" } } }
    },
    "/api/v1/profiles/validate": {
      "post": { "summary": "Alias of profile preview for validation clients", "tags": ["profiles"], "requestBody": { "required": true, "content": { "application/yaml": { "schema": { "type": "string", "description": "UTF-8 YAML; request body limited to 131072 bytes" } } } }, "responses": { "200": { "description": "Profile preview" } } }
    },
    "/api/v1/profiles/compare": {
      "post": { "summary": "Alias of profile preview emphasizing its semantic diff from active", "tags": ["profiles"], "requestBody": { "required": true, "content": { "application/yaml": { "schema": { "type": "string", "description": "UTF-8 YAML; request body limited to 131072 bytes" } } } }, "responses": { "200": { "description": "Profile preview and semantic diff" } } }
    },
    "/api/v1/profiles/probe": {
      "post": { "summary": "Preview YAML and attach a sanitized passive-only device report", "tags": ["profiles"], "requestBody": { "required": true, "content": { "application/yaml": { "schema": { "type": "string", "description": "UTF-8 YAML; request body limited to 131072 bytes" } } } }, "responses": { "200": { "description": "Profile preview, plus report when passive probing is available" } } }
    },
    "/api/v1/profiles/import": {
      "post": { "summary": "Consume an exact preview token and save YAML as an immutable inactive local revision", "tags": ["profiles"],
        "parameters": [{ "name": "X-Profile-Preview-Token", "in": "header", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/yaml": { "schema": { "type": "string", "description": "UTF-8 YAML; request body limited to 131072 bytes" } } } },
        "responses": { "200": { "description": "Saved immutable revision" }, "409": { "description": "Preview token stale, expired or bound to different bytes" }, "422": { "description": "Import rejected" } } }
    },
    "/api/v1/profiles/save": {
      "post": { "summary": "Alias of profile import used by the editor Save revision action", "tags": ["profiles"],
        "parameters": [{ "name": "X-Profile-Preview-Token", "in": "header", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/yaml": { "schema": { "type": "string", "description": "UTF-8 YAML; request body limited to 131072 bytes" } } } }, "responses": { "200": { "description": "Saved immutable revision" }, "409": { "description": "Stale preview" } } }
    },
    "/api/v1/profiles/select": {
      "post": { "summary": "Select one exact revision and schedule a controlled service restart", "tags": ["profiles"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "oneOf": [
          { "type": "object", "required": ["id", "revision", "expected_catalog_revision", "confirm"], "properties": {
            "id": { "type": "string" }, "revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "expected_catalog_revision": { "type": "integer" }, "confirm": { "type": "boolean", "enum": [true] }
          } },
          { "type": "object", "required": ["auto", "expected_catalog_revision", "confirm"], "properties": {
            "auto": { "type": "boolean", "enum": [true] }, "expected_catalog_revision": { "type": "integer" }, "confirm": { "type": "boolean", "enum": [true] }
          } }
        ] } } } }, "responses": { "202": { "description": "Selection staged; restart scheduled" }, "409": { "description": "Confirmation required or stale catalog" }, "422": { "description": "Selection rejected" } } }
    },
    "/api/v1/profiles/activate": {
      "post": { "summary": "Alias of profile select used by explicit activation clients", "tags": ["profiles"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "202": { "description": "Activation staged" }, "409": { "description": "Confirmation required or stale catalog" } } }
    },
    "/api/v1/profiles/rollback": {
      "post": { "summary": "Select only the server-recorded last-known-good selection and schedule a controlled restart", "tags": ["profiles"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["expected_catalog_revision", "confirm"] } } } }, "responses": { "202": { "description": "Rollback staged" }, "409": { "description": "Confirmation missing or catalog stale" }, "422": { "description": "No recorded rollback selection" } } }
    },
    "/api/v1/profiles/delete": {
      "post": { "summary": "Delete an inactive unselected local revision", "tags": ["profiles"], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["id", "revision", "expected_catalog_revision", "confirm"] } } } }, "responses": { "200": { "description": "Deleted" }, "409": { "description": "Confirmation required or stale catalog" }, "422": { "description": "Bundled, active, selected or protected revision" } } }
    },
    "/api/v1/config": {
      "get": { "summary": "Read full config (MQTT password redacted) incl. registry `settings` + `ha_expose` flags", "tags": ["config"], "responses": { "200": { "description": "config JSON" } } },
      "post": {
        "summary": "Update config — partial-merge: only the keys you send change. Accepts every settings-registry key (see /api/v1/config/schema) plus per-entity ha_expose_<key> toggles.", "tags": ["config"],
        "requestBody": { "content": { "application/x-www-form-urlencoded": { "schema": { "type": "object", "properties": {
          "panel_id": { "type": "string", "description": "lowercase/digits/underscore; used in entity_ids + MQTT topics" },
          "friendly_name": { "type": "string" }, "manufacturer": { "type": "string" }, "model": { "type": "string" },
          "mqtt_broker": { "type": "string", "description": "tcp://host:1883; blank = auto-discover HA on the LAN" },
          "mqtt_user": { "type": "string" }, "mqtt_password": { "type": "string", "description": "blank = unchanged" },
          "dashboard_package": { "type": "string" }, "launcher_package": { "type": "string" },
          "wake_on_wave": { "type": "boolean" }, "prevent_idle_dim": { "type": "boolean" },
          "watchdog_enabled": { "type": "boolean" }, "touch_sound": { "type": "boolean" },
          "silence_boot_chime": { "type": "boolean" }, "keep_awake": { "type": "boolean" },
          "auto_brightness": { "type": "boolean" }, "brightness_bias": { "type": "integer" },
          "navbar_mode": { "type": "string", "enum": ["Off", "Always on", "Swipe reveal"] },
          "cpu_governor": { "type": "string", "enum": ["Performance", "Efficiency", "Auto"] },
          "network_adb": { "type": "boolean" }, "zigbee_router": { "type": "boolean" },
          "home_dashboard": { "type": "string" }, "companion_auto_update": { "type": "boolean" },
          "self_update": { "type": "boolean" }, "update_channel": { "type": "string", "enum": ["stable", "prerelease"] },
          "log_ship_enabled": { "type": "boolean" }, "log_ship_host": { "type": "string" },
          "log_ship_port": { "type": "integer" }, "log_ship_protocol": { "type": "string", "enum": ["syslog", "http"] }
        } } } } },
        "responses": { "200": { "description": "updated" }, "400": { "description": "invalid panel_id" } }
      }
    },
    "/api/v1/config/schema": { "get": { "summary": "Settings-registry metadata (key/type/group/label/help/default/tier/scope/options/range + HA-capable/exposed), capability-gated to this panel", "tags": ["config"], "responses": { "200": { "description": "[{key,…}]" } } } },
    "/api/v1/config/export": {
      "get": { "summary": "Export a versioned config bundle", "tags": ["config"],
        "parameters": [{ "name": "include_secrets", "in": "query", "schema": { "type": "string", "enum": ["1"] }, "description": "include secret values (excluded by default)" }],
        "responses": { "200": { "description": "{kind, schema, exported_at, exported_by, values}" } } }
    },
    "/api/v1/config/import": {
      "post": { "summary": "Transactional bundle import: migrate → scope/secret filter → validate ALL (reject whole bundle on any failure) → snapshot revision → apply", "tags": ["config"],
        "parameters": [
          { "name": "dry_run", "in": "query", "schema": { "type": "string", "enum": ["1"] }, "description": "preview the diff without writing" },
          { "name": "mode", "in": "query", "schema": { "type": "string", "enum": ["restore", "fleet"] }, "description": "fleet = apply only portable, non-secret keys" }
        ],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "description": "a bundle from /api/v1/config/export" } } } },
        "responses": { "200": { "description": "{status, applied, skipped, warnings, errors} or the dry-run diff" }, "400": { "description": "bad-bundle" }, "422": { "description": "rejected (validation)" } } }
    },
    "/api/v1/config/revisions": { "get": { "summary": "On-panel config history (ring buffer, newest first)", "tags": ["config"], "responses": { "200": { "description": "[{id, exported_at, keys}]" } } } },
    "/api/v1/config/revisions/{id}/restore": {
      "post": { "summary": "Roll back to a stored revision (itself recorded, so restores are undoable)", "tags": ["config"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "{status:restored,…}" }, "404": { "description": "not-found" } } }
    },
    "/api/v1/ui/layout": {
      "get": { "summary": "Per-panel dashboard layout blob (customisable-layout groundwork)", "tags": ["config"], "responses": { "200": { "description": "{layout}" } } },
      "post": { "summary": "Persist the dashboard layout blob", "tags": ["config"],
        "requestBody": { "content": { "application/x-www-form-urlencoded": { "schema": { "type": "object", "properties": { "layout": { "type": "string" } } } } } },
        "responses": { "200": { "description": "{ok:true}" } } }
    },
    "/api/v1/perf": { "get": { "summary": "Live CPU/GPU/RAM, CPU clock, temperature, top processes, responsiveness + history", "tags": ["performance"], "responses": { "200": { "description": "perf JSON" } } } },
    "/api/v1/dashboard/entity-filter": {
      "get": { "summary": "Built-in-renderer entity-filter and automatic-learning status", "tags": ["performance"], "responses": { "200": { "description": "{enabled,entity_count,filter_hash,runtime,learning}" } } },
      "post": {
        "summary": "Replace/toggle the exact allow-list or opt into automatic dashboard learning", "tags": ["performance"],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": {
          "enabled": { "type": "boolean" },
          "mode": { "type": "string", "enum": ["manual", "automatic"] },
          "entity_ids": { "type": "array", "maxItems": 50000, "items": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$" } }
        } } } } },
        "responses": { "200": { "description": "Updated count/hash status; active built-in renderer reloads" }, "400": { "description": "Invalid body/entity id" }, "413": { "description": "Request too large" } }
      }
    },
    "/api/v1/dashboard/entities": {
      "get": { "summary": "Paginated learned entity catalog, membership reasons and aggregate load", "tags": ["performance"],
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "filter", "in": "query", "schema": { "type": "string", "enum": ["subscribed", "candidate", "review", "all", "excluded", "missing"] } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "maximum": 500 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } }
        ], "responses": { "200": { "description": "{items,limit,offset}" } } }
    },
    "/api/v1/dashboard/entities/sync": {
      "get": { "summary": "Automatic entity-learning status and last synchronization", "tags": ["performance"], "responses": { "200": { "description": "Learning status including dashboard_issue_count, blocking_issue_count and automatic_activation_blocked" } } },
      "post": { "summary": "Start an immediate catalog and dashboard synchronization", "tags": ["performance"], "responses": { "202": { "description": "Started" }, "409": { "description": "Already running" } } }
    },
    "/api/v1/dashboard/entities/issues": {
      "get": { "summary": "Sanitized entity-filter configuration checks and non-blocking dynamic expressions", "tags": ["performance"], "responses": { "200": { "description": "{items,dashboard_issue_count,blocking_issue_count,ignored_issue_count,dynamic_expressions}; issue items include severity, blocking, ignored, source locations, rule summary, candidate count, limit, reason and recommendation" } } },
      "post": { "summary": "Ignore or re-enable one current entity-filter safety check", "tags": ["performance"],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["fingerprint", "ignored"], "properties": {
          "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{16}$" }, "ignored": { "type": "boolean" }
        } } } } }, "responses": { "200": { "description": "Override stored and replacement scan requested" }, "400": { "description": "Issue is invalid or no longer present" } } }
    },
    "/api/v1/dashboard/entities/activate": {
      "post": { "summary": "Explicitly replace the current filter with the observed candidate set", "tags": ["performance"],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["confirm"], "properties": { "confirm": { "type": "boolean" } } } } } },
        "responses": { "200": { "description": "Candidate set applied" }, "409": { "description": "Explicit confirmation required" } } }
    },
    "/api/v1/dashboard/entities/policy": {
      "post": { "summary": "Choose which evidence sources may automatically change the live subscription", "tags": ["performance"],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["auto_static", "auto_runtime"], "properties": {
          "auto_static": { "type": "boolean", "description": "Automatically subscribe dashboard configuration references" },
          "auto_runtime": { "type": "boolean", "description": "Automatically subscribe missing entities read through hass.states" }
        } } } } }, "responses": { "200": { "description": "Policy applied, including an intentionally empty filtered subscription when applicable" }, "400": { "description": "Invalid policy" } } }
    },
    "/api/v1/dashboard/entities/override": {
      "post": { "summary": "Pin, force-exclude or return one entity to automatic membership", "tags": ["performance"],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["entity_id", "override"], "properties": {
          "entity_id": { "type": "string" }, "override": { "type": "string", "enum": ["auto", "pinned", "forced_exclude"] }, "force": { "type": "boolean" }
        } } } } }, "responses": { "200": { "description": "Applied" }, "409": { "description": "Force confirmation required" } } }
    },
    "/api/v1/dashboard/entities/overrides": {
      "post": { "summary": "Apply one override to a selected set or every suggested candidate", "tags": ["performance"],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["override"], "properties": {
          "entity_ids": { "type": "array", "maxItems": 50000, "items": { "type": "string" } }, "all_candidates": { "type": "boolean" },
          "override": { "type": "string", "enum": ["auto", "pinned", "forced_exclude"] }, "force": { "type": "boolean" }
        } } } } }, "responses": { "200": { "description": "Bulk override applied" }, "409": { "description": "Force confirmation required" } } }
    },
    "/api/v1/dashboard/entities/reset": {
      "post": { "summary": "Discard rebuildable evidence and overrides for the current dashboard", "tags": ["performance"],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["confirm"], "properties": { "confirm": { "type": "boolean" } } } } } },
        "responses": { "200": { "description": "Evidence cleared; synchronization started when automatic learning is enabled" }, "409": { "description": "Explicit confirmation required or synchronization is running" } } }
    },
    "/api/v1/dashboard/entities/export": {
      "get": { "summary": "Download the detailed local entity catalog and evidence without credentials", "tags": ["performance"], "responses": { "200": { "description": "ha-paneld-entity-catalog JSON" } } }
    },
    "/api/v1/sensors": { "get": { "summary": "Live sensor readings (light, proximity, temperature, humidity) plus volume percent and raw screen brightness — independent of HA exposure settings", "tags": ["sensors"], "responses": { "200": { "description": "live values JSON" } } } },
    "/api/v1/peers": { "get": { "summary": "ha-paneld panels discovered on the LAN over mDNS — powers the header panel switcher", "tags": ["fleet"], "parameters": [ { "name": "refresh", "in": "query", "required": false, "schema": { "type": "string", "enum": ["1"] }, "description": "Force a fresh mDNS browse instead of the ~10s cache" } ], "responses": { "200": { "description": "[{panel_id,name,ip,port,url,version,self}] — ip/url null when unresolved" } } } },
    "/api/v1/diag": { "get": { "summary": "Plain-text diagnostics dump (hardware, firmware, SELinux, su/node probes)", "tags": ["status"], "responses": { "200": { "description": "text/plain report" } } } },
    "/api/v1/info": { "get": { "summary": "Dashboard hydration payload — the probe-backed facts/value/capability fragments as ready-to-inject HTML (cached snapshot, single-flight)", "tags": ["status"], "responses": { "200": { "description": "{banners, shot, controls, cards} JSON" } } } },
    "/api/v1/logs/stream": {
      "get": { "summary": "Live log tail as Server-Sent Events (redacted logcat lines; capture stops when the last client disconnects)", "tags": ["status"],
        "parameters": [{ "name": "source", "in": "query", "schema": { "type": "string", "enum": ["app", "system"], "default": "app" }, "description": "app = ha-paneld's own process log (no root); system = full device logcat (root panels only)" }],
        "responses": { "200": { "description": "text/event-stream of log lines" }, "503": { "description": "system source requested but the panel has no root" } } }
    },
    "/api/v1/sensortrace": {
      "get": { "summary": "Debug sensor-trace ring buffer", "tags": ["sensors"],
        "parameters": [{ "name": "format", "in": "query", "schema": { "type": "string", "enum": ["csv", "json"] } }],
        "responses": { "200": { "description": "CSV (default) or JSON" } } }
    },
    "/api/v1/screenshot.png": { "get": { "summary": "Live panel screenshot (root screencap or the helper daemon); usable as an HA camera still_image_url", "tags": ["control"], "responses": { "200": { "description": "PNG" }, "503": { "description": "screenshot-unavailable" } } } },
    "/api/v1/action": {
      "post": { "summary": "On-screen nav action", "tags": ["control"],
        "requestBody": { "content": { "application/x-www-form-urlencoded": { "schema": { "type": "object", "required": ["a"], "properties": { "a": { "type": "string", "enum": ["back", "recents", "launcher", "admin_launcher", "reboot", "volup", "voldn"] } } } } } },
        "responses": { "200": { "description": "ok" }, "400": { "description": "bad-action" } } }
    },
    "/api/v1/input": {
      "post": { "summary": "Inject a tap at device pixel (x,y) — the interactive screenshot's control mode (needs root)", "tags": ["control"],
        "requestBody": { "content": { "application/x-www-form-urlencoded": { "schema": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } } } } },
        "responses": { "200": { "description": "ok" }, "400": { "description": "bad-coords" }, "503": { "description": "no-input-capability" } } }
    },
    "/api/v1/proximity": { "get": { "summary": "Live proximity raw + calibration (raw stays local; only the derived binary goes to HA)", "tags": ["proximity"], "responses": { "200": { "description": "proximity JSON" } } } },
    "/api/v1/proximity/capture": {
      "post": { "summary": "Snapshot the current raw value into the near/far calibration slot", "tags": ["proximity"],
        "requestBody": { "content": { "application/x-www-form-urlencoded": { "schema": { "type": "object", "required": ["step"], "properties": { "step": { "type": "string", "enum": ["near", "far"] } } } } } },
        "responses": { "200": { "description": "proximity JSON" }, "400": { "description": "bad-step / no-reading" } } }
    },
    "/api/v1/proximity/threshold": {
      "post": { "summary": "Manual threshold fine-tune (overrides the captured midpoint)", "tags": ["proximity"],
        "requestBody": { "content": { "application/x-www-form-urlencoded": { "schema": { "type": "object", "required": ["v"], "properties": { "v": { "type": "number" } } } } } },
        "responses": { "200": { "description": "proximity JSON" }, "400": { "description": "bad-value" } } }
    },
    "/api/v1/proximity/sensitivity": {
      "post": { "summary": "Hysteresis band width (flap resistance)", "tags": ["proximity"],
        "requestBody": { "content": { "application/x-www-form-urlencoded": { "schema": { "type": "object", "required": ["s"], "properties": { "s": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] } } } } } },
        "responses": { "200": { "description": "proximity JSON" } } }
    },
