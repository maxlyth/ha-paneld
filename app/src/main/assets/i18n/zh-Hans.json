{
  "locale": "zh-Hans",
  "schema": 1,
  "sourceRevision": "f128fbb6c62fca597e553fd6da9278b59bd32e97",
  "strings": {
    "settings.auto_brightness.help": {
      "sourceHash": "5073ca9b58a1e1351998c43b8ef589b1952549e47a6db902e9f155176eaccea7",
      "state": "machine-draft",
      "text": "面板内置引擎将照度数据流映射为背光亮度（关闭时由 HA 驱动屏幕）。"
    },
    "settings.auto_brightness.label": {
      "sourceHash": "62e10cef5de66bc5e979cb1136094352833d6d5b6ea448419cf91ff713baf59d",
      "state": "machine-draft",
      "text": "自动亮度"
    },
    "settings.auto_brightness_ha_entity.help": {
      "sourceHash": "6880e1fea6dee81c8f92542ee7bca6f70b62aecb909cf29b8b43fc5843fb5f9d",
      "state": "machine-draft",
      "text": "留空则使用面板光线传感器。面板没有合适的传感器时，请选择 Home Assistant 照度传感器。"
    },
    "settings.auto_brightness_ha_entity.label": {
      "sourceHash": "6d14150bee5d9bdc380ca70414b5d8690a2f65b9563e2e0cf7b8ecd08821882c",
      "state": "machine-draft",
      "text": "环境光源"
    },
    "settings.auto_brightness_minimum_percent.help": {
      "sourceHash": "f867987f4c5e28c720153d3438f9dd602c01a40c89539c5baab444d34bad0ce8",
      "state": "machine-draft",
      "text": "自动屏幕亮度的最低百分比。建议亮度从此下限缩放至全亮；手动亮度仍可调得更低。"
    },
    "settings.auto_brightness_minimum_percent.label": {
      "sourceHash": "b7bfe49aa148fc0b3b356e5a96f8227b2f9fec03c55364bda8724496fa699791",
      "state": "machine-draft",
      "text": "最低亮度"
    },
    "settings.auto_brightness_response_percent.help": {
      "sourceHash": "00483dd404b761c8ab8824f086f8b625edccd837f60da21feb5c8c04c0ca4333",
      "state": "machine-draft",
      "text": "引擎判定变化确实存在后，将已学习的环境光规律与当前环境光之间的差异按多大比例应用于屏幕。值越低，屏幕亮度越接近已学习的每日规律。规律仍在学习时，屏幕会直接跟随实测光线。"
    },
    "settings.auto_brightness_response_percent.label": {
      "sourceHash": "ebb57a260d58207c3cce2e12e8663ecdc0c74147d138655d6714bc577a0768f6",
      "state": "machine-draft",
      "text": "灵敏度"
    },
    "settings.auto_sleep.help": {
      "sourceHash": "5061de3660a9fc18a43615782f216134dffef4d62725528ce1d72e3927d878c9",
      "state": "machine-draft",
      "text": "检测到活动时自动唤醒面板，并在学习到的延迟后关闭屏幕。手动屏幕控制不受影响。"
    },
    "settings.auto_sleep.label": {
      "sourceHash": "69d958fb4d9465ad4a08bcec58dc47971fceba6a8631352203aa884ebd413428",
      "state": "machine-draft",
      "text": "自动休眠"
    },
    "settings.auto_sleep_activity.help": {
      "sourceHash": "d4482427fd42a99657d1319b5e54e58cd2fff9da6a24d62bc131d2b1da951b78",
      "state": "machine-draft",
      "text": "自动休眠策略当前是否让面板保持唤醒。Home Assistant 实体会提供活动历史时间线。"
    },
    "settings.auto_sleep_activity.label": {
      "sourceHash": "2881db2f92f7c139d4f0856ff75de63b3784b62c7b8c629a23de3943f1b77111",
      "state": "machine-draft",
      "text": "自动休眠活动"
    },
    "settings.camera_enabled.help": {
      "sourceHash": "7cdea3db240f425db9be12ceb307b9cb3986e5466981f26156d853e842ab2c9f",
      "state": "machine-draft",
      "text": "默认关闭。将面板摄像头作为仅视频 RTSP 流提供，并提供 JPEG 快照供 Home Assistant 拉取；只有客户端连接时画面才会离开面板，摄像头开启期间面板会持续显示红灯。"
    },
    "settings.camera_enabled.label": {
      "sourceHash": "03494b0d1f803522a3497d751eaaf6f987883cd4fe0b0e66baf67a662ae231b2",
      "state": "machine-draft",
      "text": "摄像头"
    },
    "settings.camera_fps.help": {
      "sourceHash": "194e9997f15b4e317b0e0ac24fa823fd48ebe5c87df022fc116d669f7468b631",
      "state": "machine-draft",
      "text": "流的 URL 未指定其他值时使用此设置。流 URL 可通过 ?fps= 向上或向下覆盖此值。"
    },
    "settings.camera_fps.label": {
      "sourceHash": "68e19e4ca3a5670a9f2af8b18a5b437332601a9660565681abf4555d5e67c32d",
      "state": "machine-draft",
      "text": "帧率"
    },
    "settings.camera_kbps.help": {
      "sourceHash": "6b72a5351e3c9d9317300876ebf0431307b3107808e50ba5d1d3a8d87a1c3ebe",
      "state": "machine-draft",
      "text": "流的 URL 未指定其他值时使用此设置。流 URL 可通过 ?kbps= 向上或向下覆盖此值。"
    },
    "settings.camera_kbps.label": {
      "sourceHash": "e901b7730f20569b41c76c2b2fd8154a99fec441983ab7950c36be206a2edadc",
      "state": "machine-draft",
      "text": "比特率（kbps）"
    },
    "settings.camera_resolution.help": {
      "sourceHash": "5f4cfc2712419d0f122198dfeae6c49d3b6cb094a2a090f14ab1b590963de5fb",
      "state": "machine-draft",
      "text": "流的 URL 未指定其他值时使用此设置。流 URL 可通过 ?res= 向上或向下覆盖此值。"
    },
    "settings.camera_resolution.label": {
      "sourceHash": "d4055fafa3794fa88b1e89e70c167d5a9575067a1442a6d94e9520d65a575378",
      "state": "machine-draft",
      "text": "分辨率"
    },
    "settings.companion_auto_update.help": {
      "sourceHash": "fc52865ccfdacefd48405d55bf867dd77a99eb0b2aaf0ac7b44e888abd5c0de7",
      "state": "machine-draft",
      "text": "缺失或版本过旧时，通过超级用户权限安装或更新精简版 HA Companion。"
    },
    "settings.companion_auto_update.label": {
      "sourceHash": "f81e3e21eddf2ac46d2afd74f1c975d218d54b65c701383c72561ef103c2e26a",
      "state": "machine-draft",
      "text": "Companion 自动更新"
    },
    "settings.companion_update_channel.help": {
      "sourceHash": "8ed36e3abe564c24ab183ca333b4ad8dbe6bd2119e1ba3bf939f4c7c8dc9a580",
      "state": "machine-draft",
      "text": "Companion 自动更新程序所跟随的发布通道。"
    },
    "settings.companion_update_channel.label": {
      "sourceHash": "80740dfa19b24df111ff9aa4791044aebc4b956662b02f33d8ca0d0a3f71da8f",
      "state": "machine-draft",
      "text": "Companion 自动更新通道"
    },
    "settings.cpu_governor.help": {
      "sourceHash": "44ede54df63e6b90033e3356275332934cdd2b19bf681ea7d3b65fd69a333aa9",
      "state": "machine-draft",
      "text": "重启前生效的实时 CPU 调频方案；自动表示使用 SoC 动态调速器。"
    },
    "settings.cpu_governor.label": {
      "sourceHash": "004574377e217b06381bc71633aca50cbb8494c95d2b638920bea8ffb7464280",
      "state": "machine-draft",
      "text": "CPU 方案"
    },
    "settings.dark_mode.help": {
      "sourceHash": "a3effc79661edffd5a38a30d82b89c8069d1ddb58c9eeeb0d543995d753333eb",
      "state": "machine-draft",
      "text": "设置 ha-paneld 自身界面的主题，并在没有系统深色模式设置的面板（Android 9 及更早版本）上设定仪表盘的默认配色方案。在 Home Assistant 中选择的主题会覆盖仪表盘默认值；此网页 UI 始终跟随当前浏览器的偏好。"
    },
    "settings.dark_mode.label": {
      "sourceHash": "9b7878aef90b527c22be169ed4ab97a5e216b6a1c719dc779883ef64eb85520b",
      "state": "machine-draft",
      "text": "深色模式"
    },
    "settings.dashboard_entity_auto_runtime.help": {
      "sourceHash": "14cbd01dfb904597dd78103c2703215c494ce80ee3da9b8e104e95ed7fe84ff8",
      "state": "machine-draft",
      "text": "通过 hass.states 读取到的缺失实体可自动添加。禁用后相关依据仍然可见。"
    },
    "settings.dashboard_entity_auto_runtime.label": {
      "sourceHash": "68b4661ad2eb34df5ca22139493298593ed19db51cea6f8a9f6b99512b54606e",
      "state": "machine-draft",
      "text": "自动订阅运行时访问"
    },
    "settings.dashboard_entity_auto_static.help": {
      "sourceHash": "60bbc1556abe2e80db46a3afe4cf8520d5b4d54c0a2a4a93ab5ec783152118ef",
      "state": "machine-draft",
      "text": "解析仪表盘配置时发现的实体可自动添加。禁用后相关依据仍然可见。"
    },
    "settings.dashboard_entity_auto_static.label": {
      "sourceHash": "c7cdecf9006ec1b475a1d7b4bf927a393821349a4c1e2b37184992727d5fcdb3",
      "state": "machine-draft",
      "text": "自动订阅仪表盘引用"
    },
    "settings.dashboard_entity_learning.help": {
      "sourceHash": "967aefc50fe2b2015a76cc8d98bdb0f06d14d091e1e6381ce472a45a85527cb7",
      "state": "machine-draft",
      "text": "内置渲染器：将 Home Assistant 状态流限制为仪表盘使用的实体，并学习运行时依赖项。在实体页面管理来源和固定项。"
    },
    "settings.dashboard_entity_learning.label": {
      "sourceHash": "c7b44faea3e443cbf5556ef11f22c84c864d8000ca1cbc2643d511cd6e1c218c",
      "state": "machine-draft",
      "text": "实体筛选"
    },
    "settings.dashboard_entity_learning_applied.help": {
      "sourceHash": "052ab9a70854284704fadbbe085ea13ef085793d374e851978fa36b1797119a7",
      "state": "machine-draft",
      "text": "可安全备份的启用锁存项。在安全的空白安装引导完成后，或通过实体 API 或标签页明确应用后设置。"
    },
    "settings.dashboard_entity_learning_applied.label": {
      "sourceHash": "0c0b29d53912be253a9361fd748db8ebbb9aad68760b2bbc29edb7d6472bfe68",
      "state": "machine-draft",
      "text": "应用已学习的实体筛选器"
    },
    "settings.dashboard_entity_overrides.help": {
      "sourceHash": "53fff191c7b76560deb5e9a7c63e41ad86ef48bf1ff0cbabef438a62813610b0",
      "state": "machine-draft",
      "text": "仅用于备份由实体标签页管理的明确固定实体和强制排除项。"
    },
    "settings.dashboard_entity_overrides.label": {
      "sourceHash": "631ad20ef918de7b85b8049a4b94cef70fa0209b0d21f7eaa11cec701fecf2d5",
      "state": "machine-draft",
      "text": "实体筛选器覆盖项"
    },
    "settings.dashboard_fullscreen.help": {
      "sourceHash": "12e06707302926f7af77d4589d668001ca7bfe463212db6755390a8770a106c8",
      "state": "machine-draft",
      "text": "仅限内置渲染器。仪表盘位于前台时隐藏 Android 状态栏和导航栏；从屏幕边缘滑动可暂时显示。此设置不会锁定面板，也不会隐藏 Home Assistant 导航。"
    },
    "settings.dashboard_fullscreen.label": {
      "sourceHash": "dbe81c811b381f69648e4c685e1d7c4262df9e3aebd4788d05eeebf7f4d1c2cf",
      "state": "machine-draft",
      "text": "隐藏 Android 系统栏"
    },
    "settings.dashboard_idle_return_min.help": {
      "sourceHash": "7bd07d2e5514d51ce900f99bfdb8a476ad60f0313ac603f2931db1f95bf914cf",
      "state": "machine-draft",
      "text": "内置渲染器：闲置指定分钟后返回主仪表盘。0 表示关闭。"
    },
    "settings.dashboard_idle_return_min.label": {
      "sourceHash": "0e630948da2c2c3cab7aa9c66088ab0e33197e11038e6cc2c96acbfcf7bd871d",
      "state": "machine-draft",
      "text": "闲置后返回主页（分钟）"
    },
    "settings.dashboard_native_kiosk.help": {
      "sourceHash": "c7c7b287676967b4f202d48b383452f6bd7acf953131a2bb702b5bd6bbc59723",
      "state": "machine-draft",
      "text": "仅限内置渲染器。Home Assistant 2026.4.2+ 连接后，请求其原生前端隐藏导航。默认开启；不支持或请求失败时，仪表盘保持不变。此设置不会锁定 Android，也不会向仪表盘注入 CSS。"
    },
    "settings.dashboard_native_kiosk.label": {
      "sourceHash": "a305339fcfa063612b7ae7bbb7369fec0ca25ee457ccfcb3df53c9b52060b106",
      "state": "machine-draft",
      "text": "隐藏 Home Assistant 导航（原生）"
    },
    "settings.dashboard_overscroll.help": {
      "sourceHash": "d0a5d6b615a514178fc680fc0b8ac051a07ef92da8c0fe490d8236d75d2b792c",
      "state": "machine-draft",
      "text": "内置渲染器：拖动超出仪表盘顶部或底部时，允许显示 Android 的越界拉伸或发光效果。默认关闭（墙面面板很少滚动，回弹效果也显得突兀）。仅可通过 API 设置；设为 true 可恢复原生效果。"
    },
    "settings.dashboard_overscroll.label": {
      "sourceHash": "6bb0a7d9220faa711c6dea3a7ce31f2007a53547d329f6951a5d0589873ac865",
      "state": "machine-draft",
      "text": "仪表盘越界滚动效果"
    },
    "settings.dashboard_package.help": {
      "sourceHash": "fdd2579969365f5f618bd91b0d967c0586df1834c5d3b7ca2136345cf0412143",
      "state": "machine-draft",
      "text": "用于显示仪表盘的应用。留空则使用 ha-paneld 的内置渲染器。"
    },
    "settings.dashboard_package.label": {
      "sourceHash": "e70b7822979e8c3a5f86cd4250e7fd878f8c78e14b5d46cf1ce959e1dd8d6f75",
      "state": "machine-draft",
      "text": "仪表盘应用"
    },
    "settings.dashboard_theme.help": {
      "sourceHash": "31a8245d79c9706f0327dc95c8dfb798bdc7d6b75cf8841670a8102552635258",
      "state": "machine-draft",
      "text": "仅限内置渲染器。跟随 Home Assistant 会将仪表盘的明暗选择交给 Home Assistant，深色模式设置会为其提供默认值。当 Home Assistant 设为自动时，深色和浅色可在此面板上指定主题，适用于没有侧边栏、无法进入 Home Assistant 个人资料页的自助仪表盘。Home Assistant 中明确选择的浅色或深色仍然优先；请使用自动或单独的面板用户。恢复为跟随 Home Assistant 后，选择权会按原样交还。"
    },
    "settings.dashboard_theme.label": {
      "sourceHash": "bf3c175b44e9bb6505851bf08a6a0c9f30320a493a6cdff8af55e3cdb85c1e44",
      "state": "machine-draft",
      "text": "仪表盘主题"
    },
    "settings.dashboard_zoom.help": {
      "sourceHash": "965650a061c0a7446538a192b6e4d3b508432d79ab95bb7604cec7ee9dbb3b4a",
      "state": "machine-draft",
      "text": "浏览器缩放比例。"
    },
    "settings.dashboard_zoom.label": {
      "sourceHash": "90f1077218a92f9695c9ee536c9d305ce4904146b19582386ac3b828cafd3a2b",
      "state": "machine-draft",
      "text": "缩放（%）"
    },
    "settings.diag_boot.help": {
      "sourceHash": "c2def446a0798101bd52a56491c2a741ee0e71ada93bc7c42212f294b5911289",
      "state": "machine-draft",
      "text": "面板上次启动的时间（时间戳；HA 会显示已运行时长）。"
    },
    "settings.diag_boot.label": {
      "sourceHash": "53aa51076571d5aa8285983a369c9ae68b9059d22b139c7a5572b48dc6e0b1c5",
      "state": "machine-draft",
      "text": "上次启动时间"
    },
    "settings.diag_cpu.help": {
      "sourceHash": "fffec696a134f27adbe345fbb21cdc73242616e106d18556cdc780d39f69fd37",
      "state": "machine-draft",
      "text": "CPU 总体忙碌百分比（适用于 root/su 面板；受沙盒隔离的面板不可用）。"
    },
    "settings.diag_cpu.label": {
      "sourceHash": "a10efc436db2cc6da5d2a1983dcdb8d3c20151232a1416214c133ad98da8b6f6",
      "state": "machine-draft",
      "text": "CPU 使用率"
    },
    "settings.diag_ip.help": {
      "sourceHash": "fc9c7eae6335fbf8f889d417b99e3b85420b0414b520df400826ab7d3ba203c9",
      "state": "machine-draft",
      "text": "以传感器形式提供此面板的 LAN IPv4 地址。"
    },
    "settings.diag_ip.label": {
      "sourceHash": "0302a467885abfdd4772c9e16c57edab91b02231248202d63170f1c669d13303",
      "state": "machine-draft",
      "text": "IP 地址"
    },
    "settings.diag_memory.help": {
      "sourceHash": "05f4f5d827bac7d3320fec7a9bd9454ad0865273ade60012498733ab1cf4661a",
      "state": "machine-draft",
      "text": "已用 RAM 百分比。"
    },
    "settings.diag_memory.label": {
      "sourceHash": "46e2c42a0c19ddf30ba473d20d61e77aa70357a3ce2e24acd8ce118cc93091b4",
      "state": "machine-draft",
      "text": "内存使用率"
    },
    "settings.diag_soc_temp.help": {
      "sourceHash": "5c638158a17adc55068c2fede38efe6a81cc16b4ece0d4f80fa0f9d61281601e",
      "state": "machine-draft",
      "text": "片上系统温度（适用于 root/su 面板；受沙盒隔离的面板不可用）。"
    },
    "settings.diag_soc_temp.label": {
      "sourceHash": "9f56b79622b6e3c9b5a678aebaf91708a1eec8921955e86d68a171be2b1e6bbd",
      "state": "machine-draft",
      "text": "SoC 温度"
    },
    "settings.diag_wifi_outages_24h.help": {
      "sourceHash": "cde65f42ed6eec37fb9bb3e2c9d160b951cfc99f8fb7c1f041efe21be3080cfb",
      "state": "machine-draft",
      "text": "滚动统计最近 24 小时内的短暂 Wi-Fi 断线。仅统计面板当前 Wi-Fi 连接中断；绝不计入 Home Assistant 或消息代理中断。如果面板必须限制存储量，传感器的 is_lower_bound 属性会说明该值只是下限。"
    },
    "settings.diag_wifi_outages_24h.label": {
      "sourceHash": "ed67a870b93667bed3a06e3ffdaa2d597fb1925bb05fb45a83c0e58c77d4bc12",
      "state": "machine-draft",
      "text": "Wi-Fi 中断（24 小时）"
    },
    "settings.diag_wifi_rssi.help": {
      "sourceHash": "b26ea034a2da2f7ca7713ccd7d5a8119c1d328fa74ef0f1379a2f95e646be0ca",
      "state": "machine-draft",
      "text": "Wi-Fi 为当前活动连接时的当前 Wi-Fi 接收信号强度，以 dBm 表示。"
    },
    "settings.diag_wifi_rssi.label": {
      "sourceHash": "82472695ceaca9503f2d5465578036f5c4f58ec2b0ac0fa43d4cd621f481151b",
      "state": "machine-draft",
      "text": "Wi-Fi 信号强度"
    },
    "settings.diag_wifi_ssid.help": {
      "sourceHash": "218448fba3e098e17a621bde50f139bfaa2320e24d8d61dc3891cc5b622e7933",
      "state": "machine-draft",
      "text": "当前连接为 Wi-Fi 时的当前 Wi-Fi 网络名称。该名称可能暴露位置，公开后会进入 HA 历史记录；如果没有网络信息权限，Android 可能将其隐藏。"
    },
    "settings.diag_wifi_ssid.label": {
      "sourceHash": "3cdaca1849c0f368afeddbfbd63bc1544aa5a211c097c6ce9a899a2739875011",
      "state": "machine-draft",
