    "settings.ha_token_expiry.help": {
      "sourceHash": "8ef8a848b4d7ee74a9472f0570994f379f5a7ac2f43e9b3e93201169c94a583e",
      "state": "machine-draft",
      "text": "私密备份和恢复期间，内部 OAuth 访问令牌的到期时间会与对应的访问令牌和刷新令牌一同保留。"
    },
    "settings.ha_token_expiry.label": {
      "sourceHash": "873f79f400642bcc3862b26b5dc49745b29ba3a3f1d77c3af9ccacfeae7efef6",
      "state": "machine-draft",
      "text": "HA 访问令牌到期时间"
    },
    "settings.ha_url.help": {
      "sourceHash": "40a81730fa85a59b7700f7979f11fa32decd4fb16d42f44036e4262862a47747",
      "state": "machine-draft",
      "text": "内置渲染器：Home Assistant 基础 URL，例如 http://homeassistant.local:8123。留空则禁用。"
    },
    "settings.ha_url.label": {
      "sourceHash": "d8d89efc512baff4d9d1924b627322b9b007a8c08ed95af6976dfbc684d308fa",
      "state": "machine-draft",
      "text": "Home Assistant URL"
    },
    "settings.home_dashboard.help": {
      "sourceHash": "a7ce869a298f35b4b61c1d1c2a6bde203ec6348fcfa91bf838ae882065bfd150",
      "state": "machine-draft",
      "text": "重新加载和闲置返回时使用的仪表盘。自动模式由 Home Assistant 选择。自定义模式接受特定视图，例如 /dashboard-name/tab-name。"
    },
    "settings.home_dashboard.label": {
      "sourceHash": "17cb7ca6c1fc811e633c9e1fbb1fab6a5d6cc097c937405d8cb49c8cab77c1d4",
      "state": "machine-draft",
      "text": "主仪表盘"
    },
    "settings.humidity.help": {
      "sourceHash": "0dcd9954f745cb22242cfd4b0ca708d96a89b5b3dd3a3d407cfebee0b9b0679e",
      "state": "machine-draft",
      "text": "由 Android 面板传感器报告的相对湿度。"
    },
    "settings.humidity.label": {
