      "text": "Home Assistant 中的区域"
    },
    "settings.ha_client_id.help": {
      "sourceHash": "ffae29400af4eb9ec15c30c66a9432dd116ddda13f627652a3a57144c0c5f209",
      "state": "machine-draft",
      "text": "为兼容 API 和配置导入而保留的内部令牌来源。借用的 Companion 令牌使用 Android Companion 客户端；ha-paneld 浏览器登录使用面板的 HTTP 来源。这不是用户偏好设置。"
    },
    "settings.ha_client_id.label": {
      "sourceHash": "b7ae84c506919323d0d32b4384e88205efe42a2390d7fecfa778cce2fb0677f6",
      "state": "machine-draft",
      "text": "HA OAuth client_id"
    },
    "settings.ha_refresh_token.help": {
      "sourceHash": "6366b03a354de30d09782192cf07b058b689b63e893c4b6d2c6ca6178ed23795",
      "state": "machine-draft",
      "text": "为兼容 API 和配置导入而保留的内部令牌状态。借用的 Companion 登录和 ha-paneld 签发的 OAuth 登录会自动管理它。"
    },
    "settings.ha_refresh_token.label": {
      "sourceHash": "9807017e2526d55ffd3ea99555ab867dcfdc6ab59dc56de7d1be68600ea75cc2",
      "state": "machine-draft",
      "text": "HA 刷新令牌"
