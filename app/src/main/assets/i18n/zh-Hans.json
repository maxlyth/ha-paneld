      "state": "machine-draft",
      "text": "请尽可能使用浏览器登录。此备用令牌可在 Home Assistant 用户个人资料中创建。"
    },
    "settings.ha_token.label": {
      "sourceHash": "764baf10051fe1cd66c024f9ae090ad0eb54f33b4880951fb0df0fb56fc31c41",
      "state": "machine-draft",
      "text": "长期访问令牌"
