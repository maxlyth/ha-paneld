# Local release signing — copy to `keystore.properties` (gitignored) to sign release builds with your
# real key on a laptop / devcontainer, so `./gradlew assembleRelease` installs in place over the public
# releases (no uninstall dance). Paths are relative to the repo root.
#
# NEVER commit the filled-in keystore.properties or the .jks it points at — the release private key can
# sign in-place updates for every user. Keep the .jks on your own machine. See docs/local-builds.md.
storeFile=release.jks
storePassword=CHANGEME
keyAlias=CHANGEME
keyPassword=CHANGEME
