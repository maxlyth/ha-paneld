#!/usr/bin/env bash
set -u

printf 'curl %s\n' "$*" >> "${MOCK_CALL_LOG:?MOCK_CALL_LOG is required}"

url=""
output_file=""
want_output_file=0
write_format=""
want_write_format=0
for arg in "$@"; do
  if [ "$want_output_file" = 1 ]; then
    output_file="$arg"
    want_output_file=0
    continue
  fi
  if [ "$want_write_format" = 1 ]; then
    write_format="$arg"
    want_write_format=0
    continue
  fi
  case "$arg" in
    -o|--output) want_output_file=1 ;;
    -w|--write-out) want_write_format=1 ;;
    http://*|https://*) url="$arg" ;;
  esac
done

case "$url" in
  https://github.com/maxlyth/ha-paneld/releases/download/v*/ha-paneld-helper-v*-*.sha256.sig)
    [ -n "$output_file" ] || exit 2
    [ "${MOCK_HELPER_PROOF_DOWNLOAD:-ok}" = "signature_fail" ] && exit 22
    printf 'mock detached helper signature\n' > "$output_file"
    ;;
  https://github.com/maxlyth/ha-paneld/releases/download/v*/ha-paneld-helper-v*-*.sha256)
    [ -n "$output_file" ] || exit 2
    [ "${MOCK_HELPER_PROOF_DOWNLOAD:-ok}" = "checksum_fail" ] && exit 22
    helper="${RELEASE_HELPER_SOURCE:-}"
    [ -n "$helper" ] && [ -f "$helper" ] || exit 2
    asset="$(basename "$url" .sha256)"
    case "${MOCK_HELPER_CHECKSUM:-ok}" in
      ok) hash="$(/usr/bin/sha256sum "$helper" | awk '{print $1}')"; printf '%s  %s\n' "$hash" "$asset" > "$output_file" ;;
      mismatch) printf '%064d  %s\n' 0 "$asset" > "$output_file" ;;
      malformed) printf 'this is not a helper checksum record\n' > "$output_file" ;;
      *) exit 2 ;;
    esac
    ;;
  https://github.com/maxlyth/ha-paneld/releases/download/v*/ha-paneld-helper-v*-*)
    [ -n "$output_file" ] || exit 2
    printf 'mock release helper\n' > "$output_file"
    ;;
  https://github.com/maxlyth/ha-paneld/releases/download/v*/ha-paneld-provision-v*.sh.sha256.sig)
    [ -n "$output_file" ] || exit 2
    [ "${MOCK_INSTALLER_PROOF_DOWNLOAD:-ok}" = "signature_fail" ] && exit 22
    printf 'mock detached provisioner signature\n' > "$output_file"
    ;;
  https://github.com/maxlyth/ha-paneld/releases/download/v*/ha-paneld-provision-v*.sh.sha256)
    [ -n "$output_file" ] || exit 2
    [ "${MOCK_INSTALLER_PROOF_DOWNLOAD:-ok}" = "checksum_fail" ] && exit 22
    asset="$(basename "$url" .sha256)"
    case "${MOCK_INSTALLER_CHECKSUM:-ok}" in
      ok)
        if [ -n "${RELEASE_PROVISION_SOURCE:-}" ]; then
          hash="$(/usr/bin/sha256sum "$RELEASE_PROVISION_SOURCE" | awk '{print $1}')"
        else
          case "${MOCK_RELEASE_PROVISION_BUILD_ID:-${MOCK_HELPER_BUILD_ID:?}}" in
            missing) provision_body='mock authenticated provisioner' ;;
            *) provision_body="$(printf 'mock authenticated provisioner\nRELEASE_HELPER_BUILD_ID=\"%s\"' \
              "${MOCK_RELEASE_PROVISION_BUILD_ID:-${MOCK_HELPER_BUILD_ID:?}}")" ;;
          esac
          hash="$(printf '%s\n' "$provision_body" | /usr/bin/sha256sum | awk '{print $1}')"
        fi
        printf '%s  %s\n' "$hash" "$asset" > "$output_file"
        ;;
      mismatch) printf '%064d  %s\n' 0 "$asset" > "$output_file" ;;
      malformed) printf 'this is not a provisioner checksum record\n' > "$output_file" ;;
      *) exit 2 ;;
    esac
    ;;
  https://github.com/maxlyth/ha-paneld/releases/download/v*/ha-paneld-provision-v*.sh)
    [ -n "$output_file" ] || exit 2
    case "${MOCK_RELEASE_PROVISION_BUILD_ID:-${MOCK_HELPER_BUILD_ID:?}}" in
      missing) printf 'mock authenticated provisioner\n' > "$output_file" ;;
      *) printf 'mock authenticated provisioner\nRELEASE_HELPER_BUILD_ID="%s"\n' \
        "${MOCK_RELEASE_PROVISION_BUILD_ID:-${MOCK_HELPER_BUILD_ID:?}}" > "$output_file" ;;
    esac
    ;;
  https://raw.githubusercontent.com/maxlyth/ha-paneld/v0.9.2/scripts/provision.sh)
    [ -n "$output_file" ] || exit 2
    printf 'mock legacy provisioner\n' > "$output_file"
    ;;
  https://github.com/RikkaApps/Shizuku/releases/download/v13.6.0/shizuku-v13.6.0.r1086.2650830c-release.apk)
    [ -n "$output_file" ] || exit 2
    printf 'mock pinned Shizuku manager apk\n' > "$output_file"
    ;;
  https://github.com/maxlyth/ha-paneld/releases/download/v*/ha-paneld-v*-manual-setup-required.apk.sha256.sig)
    [ -n "$output_file" ] || exit 2
    [ "${MOCK_RELEASE_PROOF_DOWNLOAD:-ok}" = "signature_fail" ] && exit 22
    printf 'mock detached release signature\n' > "$output_file"
    ;;
  https://github.com/maxlyth/ha-paneld/releases/download/v*/ha-paneld-v*-manual-setup-required.apk.sha256)
    [ -n "$output_file" ] || exit 2
    [ "${MOCK_RELEASE_PROOF_DOWNLOAD:-ok}" = "checksum_fail" ] && exit 22
    apk="${RELEASE_APK_SOURCE:-}"
    [ -n "$apk" ] && [ -f "$apk" ] || exit 2
    asset="$(basename "$url" .sha256)"
    case "${MOCK_RELEASE_CHECKSUM:-ok}" in
      ok) hash="$(/usr/bin/sha256sum "$apk" | awk '{print $1}')"; printf '%s  %s\n' "$hash" "$asset" > "$output_file" ;;
      mismatch) printf '%064d  %s\n' 0 "$asset" > "$output_file" ;;
      malformed) printf 'this is not a checksum record\n' > "$output_file" ;;
      *) exit 2 ;;
    esac
    ;;
  https://api.github.com/repos/maxlyth/ha-paneld/releases\?per_page=100)
    case "${MOCK_GITHUB_API:-fail}" in
      pretty) cat <<'JSON'
[
  {
    "url": "https://api.github.com/repos/maxlyth/ha-paneld/releases/200",
    "tag_name": "v0.9.1",
    "draft": false,
    "prerelease": false,
    "assets": [{"url": "https://api.github.com/repos/maxlyth/ha-paneld/releases/assets/900", "browser_download_url": "https://github.com/maxlyth/ha-paneld/releases/download/v0.9.1/ha-paneld-v0.9.1-manual-setup-required.apk"}]
  },
  {
    "url": "https://api.github.com/repos/maxlyth/ha-paneld/releases/201",
    "tag_name": "v0.9.2-rc3",
    "draft": false,
    "prerelease": true,
    "assets": [{"url": "https://api.github.com/repos/maxlyth/ha-paneld/releases/assets/901", "browser_download_url": "https://github.com/maxlyth/ha-paneld/releases/download/v0.9.2-rc3/ha-paneld-v0.9.2-rc3-manual-setup-required.apk"}]
  }
]
JSON
        ;;
      oversized)
        # Keep the selected prerelease small, then exceed typical pipe buffers with an older
        # release. An early-exiting consumer makes an upstream stage fail with SIGPIPE.
        printf '%s' '[{"url":"https://api.github.com/repos/maxlyth/ha-paneld/releases/201","tag_name":"v0.9.2-rc3","draft":false,"prerelease":true,"assets":[{"browser_download_url":"https://github.com/maxlyth/ha-paneld/releases/download/v0.9.2-rc3/ha-paneld-v0.9.2-rc3-manual-setup-required.apk"}]},{"url":"https://api.github.com/repos/maxlyth/ha-paneld/releases/200","tag_name":"v0.9.1","draft":false,"prerelease":false,"padding":"'
        awk 'BEGIN { for (i = 0; i < 2097152; i++) printf "x" }'
        printf '%s\n' '"}]'
        ;;
      foreign) cat <<'JSON'
[
  {
    "url": "https://api.github.com/repos/maxlyth/ha-paneld/releases/201",
    "tag_name": "v0.9.2-rc3",
    "draft": false,
    "prerelease": true,
    "assets": [{"browser_download_url": "https://downloads.test/ha-paneld-v0.9.2-rc3-manual-setup-required.apk"}]
  }
]
JSON
        ;;
      *) exit 22 ;;
    esac
    ;;
  https://api.github.com/repos/maxlyth/ha-paneld/releases/latest)
    case "${MOCK_INSTALLER_RELEASE_API:-fail}" in
      legacy) tag=v0.9.2 ;;
      authenticated) tag=v0.9.3 ;;
      *) exit 22 ;;
    esac
    printf '{"tag_name":"%s","assets":[{"browser_download_url":"https://github.com/maxlyth/ha-paneld/releases/download/%s/ha-paneld-%s-manual-setup-required.apk"}]}\n' "$tag" "$tag" "$tag"
    ;;
  https://github.com/maxlyth/ha-paneld/releases/download/v*/ha-paneld-v*-manual-setup-required.apk)
    [ -n "$output_file" ] || exit 2
    printf 'test apk\n' > "$output_file"
    ;;
  */auth/login_flow)
    [ "${MOCK_HA_LOGIN:-ok}" = "timeout" ] && exit 28
    [ "${MOCK_HA_LOGIN:-ok}" = "flow_fail" ] && exit 22
    printf '{"flow_id":"flow-1"}\n'
    ;;
  */auth/login_flow/*)
    [ "${MOCK_HA_LOGIN:-ok}" = "timeout" ] && exit 28
    [ "${MOCK_HA_LOGIN:-ok}" = "rejected" ] && printf '{"errors":{"base":"invalid_auth"}}\n' || printf '{"result":"auth-code"}\n'
    ;;
  */auth/token)
    [ "${MOCK_HA_LOGIN:-ok}" = "timeout" ] && exit 28
    if [ "${MOCK_HA_LOGIN:-ok}" = "token_missing" ]; then printf '{}\n';
    else printf '{"access_token":"access","refresh_token":"refresh","expires_in":1800}\n'; fi
    ;;
  */api/)
    [ "${MOCK_HA_TOKEN:-ok}" = "ok" ] || exit 22
    printf '{"message":"API running."}\n'
    ;;
  */health)
    [ "${MOCK_HEALTH:-ok}" = "ok" ] || exit 22
    printf 'ha-paneld test health\n'
    ;;
  */api/v1/provisioning/plan.txt)
    plan_status=200
    case "${MOCK_PLAN:-ok}" in
      ok|recommendations|control) ;;
      missing) plan_status=404 ;;
      transient)
        attempts="${MOCK_STATE_DIR:?}/plan-attempts"
        if [ ! -f "$attempts" ]; then : > "$attempts"; plan_status=503; fi
        ;;
      unstable) plan_status=503 ;;
      *) plan_status=500 ;;
    esac
    if [ "$plan_status" = 200 ] && [ -n "$output_file" ]; then
      if [ "${MOCK_PLAN:-ok}" = "recommendations" ]; then
        printf 'Detected panel: Test Panel\nRecommended: install the root helper\nRecommended: update System WebView\n' > "$output_file"
      elif [ "${MOCK_PLAN:-ok}" = "control" ]; then
        printf 'Detected panel: Hostile\033]2;forged title\007\nProvisioning guidance: safe\n' > "$output_file"
      else
        printf 'Detected panel: Test Panel\nProvisioning guidance: no required changes\n' > "$output_file"
      fi
    fi
    if [ -n "$write_format" ]; then
      printf '%s' "$plan_status"
    elif [ "$plan_status" = 200 ]; then
      printf 'Detected panel: Test Panel\nProvisioning guidance: no required changes\n'
    fi
    ;;
  */api/v1/diag)
    if [ "${MOCK_VERIFY:-ok}" = "transient" ]; then
      attempts="${MOCK_STATE_DIR:?}/diag-attempts"
      if [ ! -f "$attempts" ]; then : > "$attempts"; exit 22; fi
    elif [ "${MOCK_VERIFY:-ok}" = "stale" ]; then
      printf 'ha-paneld diagnostics write_settings=false a11y=false su=true daemon=true\n'
      exit 0
    elif [ "${MOCK_VERIFY:-ok}" != "ok" ]; then
      exit 22
    fi
    case "$url" in *"${MOCK_VERIFY_FAIL_HOST:-__no_host__}"*) exit 22 ;; esac
    printf 'ha-paneld diagnostics write_settings=true a11y=true su=true daemon=true\n'
    ;;
  *'/api/v1/config/export?include_secrets=1')
    [ "${MOCK_EXPORT:-ok}" = "ok" ] || exit 22
    if [ -n "$output_file" ]; then
      printf '{"panel_id":"test-panel","mqtt_broker":""}\n' > "$output_file"
    else
      printf '{"panel_id":"test-panel","mqtt_broker":""}\n'
    fi
    ;;
  */api/v1/config/import*)
    [ "${MOCK_RESTORE:-ok}" = "timeout" ] && exit 28
    [ "${MOCK_RESTORE:-ok}" = "ok" ] || exit 22
    printf '{"ok":true}\n'
    ;;
  */api/v1/config)
    if printf '%s\n' "$*" | grep -q -- '-X POST'; then
      [ "${MOCK_CONFIG:-ok}" = "timeout" ] && exit 28
      [ "${MOCK_CONFIG:-ok}" = "ok" ] || exit 22
      printf '{"ok":true}\n'
    else
      printf '{"panel_id":"test-panel","mqtt_broker":""}\n'
    fi
    ;;
  */api/v1/tame)
    printf '{"ok":true}\n'
    ;;
  *)
    printf 'mock curl has no response for %s\n' "$url" >&2
    exit 22
    ;;
esac
