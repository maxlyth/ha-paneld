#!/usr/bin/env bash
set -u

printf 'apksigner %s\n' "$*" >> "${MOCK_CALL_LOG:?MOCK_CALL_LOG is required}"
case "$*" in
  *ha-paneld-v*-manual-setup-required.apk*)
    [ "${MOCK_RELEASE_VERIFY_FAIL:-0}" = 0 ] || exit 1
    printf 'Signer #1 certificate SHA-256 digest: %s\n' "${MOCK_RELEASE_CERT:-ac6193307fb0b70113aae205d7549406f96e063bc5491b67b1d5694a34b0e339}"
    ;;
  *)
    [ "${MOCK_SHIZUKU_TRUSTED:-0}" = 1 ] || exit 1
    printf 'Signer #1 certificate SHA-256 digest: 268b5590e868fb08bae7e0ac413564cd1ff88f5ccff74af9dbd0dc918e30db30\n'
    ;;
esac
