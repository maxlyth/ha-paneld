#!/usr/bin/env bash
set -u

printf 'gh %s\n' "$*" >> "${MOCK_CALL_LOG:?MOCK_CALL_LOG is required}"
[ "${MOCK_GH_FAIL:-0}" = 1 ] && exit 1

if [ "${1:-}" = "release" ] && [ "${2:-}" = "list" ]; then
  printf 'v0.9.2-rc3\n'
  exit 0
fi

if [ "${1:-}" = "release" ] && [ "${2:-}" = "view" ]; then
  printf 'v0.9.1\n'
  exit 0
fi

if [ "${1:-}" = "release" ] && [ "${2:-}" = "download" ]; then
  directory=""
  previous=""
  for argument in "$@"; do
    if [ "$previous" = "--dir" ]; then directory="$argument"; break; fi
    previous="$argument"
  done
  [ -n "$directory" ] || exit 2
  tag="v0.9.2-rc3"
  for argument in "$@"; do case "$argument" in v*) tag="$argument" ;; esac; done
  printf 'test apk\n' > "$directory/ha-paneld-$tag-manual-setup-required.apk"
  exit 0
fi

exit 2
