#!/usr/bin/env bash
set -u

printf 'adb %s\n' "$*" >> "${MOCK_CALL_LOG:?MOCK_CALL_LOG is required}"
STATE_DIR="${MOCK_STATE_DIR:-$(dirname "$MOCK_CALL_LOG")}"
[ -f "$STATE_DIR/installed-apk" ] || printf 'previous installed apk\n' > "$STATE_DIR/installed-apk"

if [ "${1:-}" = "connect" ]; then
  exit 0
fi

if [ "${1:-}" = "devices" ]; then
  state="${MOCK_ADB_STATE:-device}"
  printf 'List of devices attached\n'
  if [ "$state" != "missing" ]; then
    for target in ${MOCK_TARGETS:-${MOCK_TARGET:-panel.test:5555}}; do printf '%s\t%s\n' "$target" "$state"; done
  fi
  exit 0
fi

if [ "${1:-}" = "-s" ]; then
  shift 2
fi

case "${1:-}" in
  root)
    [ "${MOCK_ROOT:-1}" = 1 ]
    ;;
  push)
    ;;
  pull)
    [ "${MOCK_APK_QUERY:-ok}" = ok ] || exit 1
    cp "$STATE_DIR/installed-apk" "${3:?pull destination missing}"
    ;;
  install)
    if [ "${MOCK_APK_INSTALL:-ok}" = ok ]; then
      cp "${!#}" "$STATE_DIR/installed-apk"
      printf 'Success\n'
    elif [ "${MOCK_APK_INSTALL:-ok}" = ambiguous_commit ]; then
      cp "${!#}" "$STATE_DIR/installed-apk"
      printf 'error: transport closed after install request\n' >&2
      exit 1
    else
      printf '%s\n' "${MOCK_APK_INSTALL_OUTPUT:-Failure [INSTALL_FAILED_INSUFFICIENT_STORAGE]}"
      exit 1
    fi
    ;;
  disconnect)
    ;;
  shell)
    shift
    command_text="$*"
    case "$command_text" in
      "dumpsys package moe.shizuku.privileged.api")
        if [ -n "${MOCK_SHIZUKU_VERSION_CODE:-}" ]; then
          printf 'versionName=13.6.0\nversionCode=%s minSdk=23\n' "$MOCK_SHIZUKU_VERSION_CODE"
        fi
        ;;
      "pm path moe.shizuku.privileged.api")
        if [ -n "${MOCK_SHIZUKU_VERSION_CODE:-}" ]; then
          printf 'package:/data/app/moe.shizuku.privileged.api/base.apk\n'
        fi
        ;;
      "pm path io.github.maxlyth.hapaneld")
        [ "${MOCK_APK_QUERY:-ok}" = ok ] || exit 1
        [ -f "$STATE_DIR/installed-apk" ] && printf 'package:/data/app/io.github.maxlyth.hapaneld/base.apk\n'
        ;;
      "test -f /storage/emulated/0/Android/data/moe.shizuku.privileged.api/start.sh")
        [ "${MOCK_SHIZUKU_START_SCRIPT:-ok}" = "ok" ]
        ;;
      "sh /storage/emulated/0/Android/data/moe.shizuku.privileged.api/start.sh")
        if [ "${MOCK_SHIZUKU_START:-ok}" = "hang" ]; then
          [ -z "${MOCK_SHIZUKU_HANG_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_SHIZUKU_HANG_PID_FILE"
          exec /bin/sleep 60
        fi
        if [ "${MOCK_SHIZUKU_START:-ok}" = "hang_with_child" ]; then
          /bin/sleep 60 &
          child_pid=$!
          [ -z "${MOCK_SHIZUKU_HANG_PID_FILE:-}" ] || printf '%s %s\n' "$$" "$child_pid" > "$MOCK_SHIZUKU_HANG_PID_FILE"
          trap 'kill -TERM "$child_pid" 2>/dev/null || true; wait "$child_pid" 2>/dev/null || true; exit 143' TERM INT
          wait "$child_pid"
        fi
        [ "${MOCK_SHIZUKU_START:-ok}" = "ok" ]
        ;;
      "dumpsys package "*)
        printf 'versionName=%s\n' "${MOCK_INSTALLED_VERSION:-0.9.1}"
        ;;
      "getprop ro.product.cpu.abi")
        printf '%s\n' "${MOCK_ABI:-arm64-v8a}"
        ;;
      "settings get secure enabled_accessibility_services")
        printf 'null\n'
        ;;
      "settings get global adb_enabled")
        if [ "${MOCK_LATE_ADB_PHASE:-identity}" = "persistence" ] && [ "${MOCK_LATE_ADB_STATUS:-0}" -ne 0 ]; then
          exit "$MOCK_LATE_ADB_STATUS"
        fi
        printf '%s\n' "${MOCK_ADB_ENABLED:-1}"
        ;;
      "getprop ro.product.brand"|"getprop ro.product.model")
        if [ "${MOCK_LATE_ADB_PHASE:-identity}" = "identity" ] && [ "${MOCK_LATE_ADB_STATUS:-0}" -ne 0 ]; then
          exit "$MOCK_LATE_ADB_STATUS"
        fi
        printf '%s\n' "${MOCK_PRODUCT_IDENTITY:-}"
        ;;
      "getprop persist.adb.tcp.port")
        if [ "${MOCK_LATE_ADB_PHASE:-identity}" = "persistence" ] && [ "${MOCK_LATE_ADB_STATUS:-0}" -ne 0 ]; then
          exit "$MOCK_LATE_ADB_STATUS"
        fi
        printf '%s\n' "${MOCK_ADB_TCP_PORT:-5555}"
        ;;
      "dumpsys webviewupdate")
        printf 'Current WebView package (name, version): (com.android.webview, %s)\n' "${MOCK_WEBVIEW_VERSION:-150.0.0.0}"
        ;;
      "id")
        if [ "${MOCK_ADB_ROOT:-0}" = 1 ]; then
          printf 'uid=0(root) gid=0(root)\n'
        else
          printf 'uid=2000(shell) gid=2000(shell)\n'
        fi
        ;;
      'su 0 "'*'"')
        if printf '%s' "$command_text" | grep -Fq 'id; id' && [ "${MOCK_SU_DIALECT:-join}" = join ]; then
          [ "${MOCK_ROOT:-1}" = 1 ] && printf 'uid=0(root) gid=0(root)\n'
        elif printf '%s' "$command_text" | grep -Fq '.hapaneld-helper-manual-upgrade' && \
             printf '%s' "$command_text" | grep -Fq '[ ! -f'; then
          [ "${MOCK_MANUAL_STALE:-0}" != 1 ]
        elif printf '%s' "$command_text" | grep -Fq 'touch /system/.rw_probe'; then
          if [ "${MOCK_SYSTEM_WRITABLE:-1}" = 1 ]; then
            printf 'SYSTEM_RW\n'
          else
            printf 'SYSTEM_RO\n'
            if [ "${MOCK_SYSTEMLESS_RUNNER:-1}" = 1 ]; then printf 'SYSTEMLESS_RUNNER\n'; else printf 'NO_SYSTEMLESS_RUNNER\n'; fi
          fi
        elif printf '%s' "$command_text" | grep -Eq 'hapaneld-helper\.txn install-(system|systemless)'; then
          if [ -f "$STATE_DIR/stale-helper-transaction" ]; then
            printf 'STALE_TRANSACTION\n'
          else
            [ "${MOCK_HELPER_INSTALL:-ok}" = ok ] && printf 'INSTALL_OK\n'
            [ "${MOCK_HELPER_INSTALL:-ok}" != ok ] || : > "$STATE_DIR/active-helper-transaction"
          fi
        elif printf '%s' "$command_text" | grep -Eq 'hapaneld-helper\.txn rollback-(system|systemless)'; then
          [ "${MOCK_ROLLBACK_RESULT:-ok}" = ok ] && printf 'ROLLBACK_RESTARTED\n'
          rm -f "$STATE_DIR/stale-helper-transaction" "$STATE_DIR/active-helper-transaction"
        elif printf '%s' "$command_text" | grep -Eq 'hapaneld-helper\.txn commit-(system|systemless)'; then
          rm -f "$STATE_DIR/stale-helper-transaction" "$STATE_DIR/active-helper-transaction"
        elif printf '%s' "$command_text" | grep -Eq 'hapaneld-helper\.txn status-(system|systemless)'; then
          printf 'JOURNAL_VERSION=1\nJOURNAL_SCOPE=%s\nTARGET_APK_SHA256=%s\nTARGET_BUILD_ID=%s\nTARGET_HELPER_SHA256=%s\n' \
            "${MOCK_STALE_SCOPE:-APK_HELPER}" "${MOCK_STALE_APK_SHA256:?}" \
            "${MOCK_STALE_BUILD_ID:-${MOCK_HELPER_BUILD_ID:?}}" "${MOCK_STALE_HELPER_SHA256:-$(printf '%064d' 0)}"
        elif printf '%s' "$command_text" | grep -Fq 'pidof hapaneld-helper'; then
          [ "${MOCK_HELPER_START:-ok}" = ok ] && printf '4242\n'
        fi
        ;;
      'su 0 sh -c "'*'"')
        if printf '%s' "$command_text" | grep -Fq 'id; id' && [ "${MOCK_SU_DIALECT:-join}" = shc ]; then
          [ "${MOCK_ROOT:-1}" = 1 ] && printf 'uid=0(root) gid=0(root)\n'
        elif printf '%s' "$command_text" | grep -Fq '.hapaneld-helper-manual-upgrade' && \
             printf '%s' "$command_text" | grep -Fq '[ ! -f'; then
          [ "${MOCK_MANUAL_STALE:-0}" != 1 ]
        elif printf '%s' "$command_text" | grep -Fq 'touch /system/.rw_probe'; then
          if [ "${MOCK_SYSTEM_WRITABLE:-1}" = 1 ]; then
            printf 'SYSTEM_RW\n'
          else
            printf 'SYSTEM_RO\n'
            if [ "${MOCK_SYSTEMLESS_RUNNER:-1}" = 1 ]; then printf 'SYSTEMLESS_RUNNER\n'; else printf 'NO_SYSTEMLESS_RUNNER\n'; fi
          fi
        elif printf '%s' "$command_text" | grep -Eq 'hapaneld-helper\.txn install-(system|systemless)'; then
          if [ -f "$STATE_DIR/stale-helper-transaction" ]; then
            printf 'STALE_TRANSACTION\n'
          else
            [ "${MOCK_HELPER_INSTALL:-ok}" = ok ] && printf 'INSTALL_OK\n'
            [ "${MOCK_HELPER_INSTALL:-ok}" != ok ] || : > "$STATE_DIR/active-helper-transaction"
          fi
        elif printf '%s' "$command_text" | grep -Eq 'hapaneld-helper\.txn rollback-(system|systemless)'; then
          [ "${MOCK_ROLLBACK_RESULT:-ok}" = ok ] && printf 'ROLLBACK_RESTARTED\n'
          rm -f "$STATE_DIR/stale-helper-transaction" "$STATE_DIR/active-helper-transaction"
        elif printf '%s' "$command_text" | grep -Eq 'hapaneld-helper\.txn commit-(system|systemless)'; then
          rm -f "$STATE_DIR/stale-helper-transaction" "$STATE_DIR/active-helper-transaction"
        elif printf '%s' "$command_text" | grep -Eq 'hapaneld-helper\.txn status-(system|systemless)'; then
          printf 'JOURNAL_VERSION=1\nJOURNAL_SCOPE=%s\nTARGET_APK_SHA256=%s\nTARGET_BUILD_ID=%s\nTARGET_HELPER_SHA256=%s\n' \
            "${MOCK_STALE_SCOPE:-APK_HELPER}" "${MOCK_STALE_APK_SHA256:?}" \
            "${MOCK_STALE_BUILD_ID:-${MOCK_HELPER_BUILD_ID:?}}" "${MOCK_STALE_HELPER_SHA256:-$(printf '%064d' 0)}"
        fi
        ;;
    esac
    ;;
  *)
    ;;
esac
