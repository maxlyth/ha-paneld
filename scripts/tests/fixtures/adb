#!/usr/bin/env bash
set -u

printf 'adb %s\n' "$*" >> "${MOCK_CALL_LOG:?MOCK_CALL_LOG is required}"
STATE_DIR="${MOCK_STATE_DIR:-$(dirname "$MOCK_CALL_LOG")}"
[ -f "$STATE_DIR/installed-apk" ] || printf 'previous installed apk\n' > "$STATE_DIR/installed-apk"

if [ "${1:-}" = "connect" ]; then
  exit 0
fi

if [ "${1:-}" = "devices" ]; then
  state="${MOCK_ADB_STATE:-device}"
  printf 'List of devices attached\n'
  if [ "$state" != "missing" ]; then
    for target in ${MOCK_TARGETS:-${MOCK_TARGET:-panel.test:5555}}; do printf '%s\t%s\n' "$target" "$state"; done
  fi
  exit 0
fi

if [ "${1:-}" = "-s" ]; then
  shift 2
fi

case "${1:-}" in
  root)
    [ "${MOCK_ROOT:-1}" = 1 ]
    ;;
  push)
    ;;
  pull)
    [ "${MOCK_APK_QUERY:-ok}" = ok ] || exit 1
    cp "$STATE_DIR/installed-apk" "${3:?pull destination missing}"
    ;;
  install)
    if [[ "${!#}" == */shizuku.apk ]] && [ "${MOCK_SHIZUKU_INSTALL:-ok}" = block ]; then
      [ -z "${MOCK_SHIZUKU_INSTALL_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_SHIZUKU_INSTALL_PID_FILE"
      trap 'exit 143' TERM INT
      while :; do /bin/sleep 1; done
    elif [ "${MOCK_APK_INSTALL:-ok}" = block ]; then
      [ -z "${MOCK_APK_INSTALL_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_APK_INSTALL_PID_FILE"
      trap 'exit 143' TERM INT
      while :; do /bin/sleep 1; done
    elif [ "${MOCK_APK_INSTALL:-ok}" = ok ]; then
      cp "${!#}" "$STATE_DIR/installed-apk"
      printf 'Success\n'
    elif [ "${MOCK_APK_INSTALL:-ok}" = ambiguous_commit ]; then
      cp "${!#}" "$STATE_DIR/installed-apk"
      printf 'error: transport closed after install request\n' >&2
      exit 1
    else
      printf '%s\n' "${MOCK_APK_INSTALL_OUTPUT:-Failure [INSTALL_FAILED_INSUFFICIENT_STORAGE]}"
      exit 1
    fi
    ;;
  disconnect)
    ;;
  shell)
    shift
    command_text="$*"
    case "$command_text" in
      "dumpsys package moe.shizuku.privileged.api")
        if [ "${MOCK_SHIZUKU_INSPECT:-ok}" = block ]; then
          [ -z "${MOCK_SHIZUKU_INSPECT_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_SHIZUKU_INSPECT_PID_FILE"
          trap 'exit 143' TERM INT
          while :; do /bin/sleep 1; done
        fi
        if [ -n "${MOCK_SHIZUKU_VERSION_CODE:-}" ]; then
          printf 'versionName=13.6.0\nversionCode=%s minSdk=23\n' "$MOCK_SHIZUKU_VERSION_CODE"
        fi
        ;;
      "pm path moe.shizuku.privileged.api")
        if [ -n "${MOCK_SHIZUKU_VERSION_CODE:-}" ]; then
          printf 'package:/data/app/moe.shizuku.privileged.api/base.apk\n'
        fi
        ;;
      "pm path io.github.maxlyth.hapaneld")
        [ "${MOCK_APK_QUERY:-ok}" = ok ] || exit 1
        [ -f "$STATE_DIR/installed-apk" ] && printf 'package:/data/app/io.github.maxlyth.hapaneld/base.apk\n'
        ;;
      "test -f /storage/emulated/0/Android/data/moe.shizuku.privileged.api/start.sh")
        [ "${MOCK_SHIZUKU_START_SCRIPT:-ok}" = "ok" ]
        ;;
      "sh /storage/emulated/0/Android/data/moe.shizuku.privileged.api/start.sh")
        if [ "${MOCK_SHIZUKU_START:-ok}" = "hang" ]; then
          [ -z "${MOCK_SHIZUKU_HANG_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_SHIZUKU_HANG_PID_FILE"
          exec /bin/sleep 60
        fi
        if [ "${MOCK_SHIZUKU_START:-ok}" = "hang_with_child" ]; then
          /bin/sleep 60 &
          child_pid=$!
          [ -z "${MOCK_SHIZUKU_HANG_PID_FILE:-}" ] || printf '%s %s\n' "$$" "$child_pid" > "$MOCK_SHIZUKU_HANG_PID_FILE"
          trap 'kill -TERM "$child_pid" 2>/dev/null || true; wait "$child_pid" 2>/dev/null || true; exit 143' TERM INT
          wait "$child_pid"
        fi
        [ "${MOCK_SHIZUKU_START:-ok}" = "ok" ]
        ;;
      "dumpsys package "*)
        printf 'versionName=%s\n' "${MOCK_INSTALLED_VERSION:-0.9.1}"
        ;;
      "getprop ro.product.cpu.abi")
        printf '%s\n' "${MOCK_ABI:-arm64-v8a}"
        ;;
      "settings get secure enabled_accessibility_services")
        printf 'null\n'
        ;;
      "settings get global adb_enabled")
        if [ "${MOCK_LATE_ADB_PHASE:-identity}" = "persistence" ] && [ "${MOCK_LATE_ADB_STATUS:-0}" -ne 0 ]; then
          exit "$MOCK_LATE_ADB_STATUS"
        fi
        printf '%s\n' "${MOCK_ADB_ENABLED:-1}"
        ;;
      "getprop ro.product.brand"|"getprop ro.product.model")
        if [ "${MOCK_LATE_ADB_PHASE:-identity}" = "identity" ] && [ "${MOCK_LATE_ADB_STATUS:-0}" -ne 0 ]; then
          exit "$MOCK_LATE_ADB_STATUS"
        fi
        printf '%s\n' "${MOCK_PRODUCT_IDENTITY:-}"
        ;;
      "getprop persist.adb.tcp.port")
        if [ "${MOCK_LATE_ADB_PHASE:-identity}" = "persistence" ] && [ "${MOCK_LATE_ADB_STATUS:-0}" -ne 0 ]; then
          exit "$MOCK_LATE_ADB_STATUS"
        fi
        printf '%s\n' "${MOCK_ADB_TCP_PORT:-5555}"
        ;;
      "dumpsys webviewupdate")
        printf 'Current WebView package (name, version): (com.android.webview, %s)\n' "${MOCK_WEBVIEW_VERSION:-150.0.0.0}"
        ;;
      "id")
        if [ "${MOCK_ADB_ROOT:-0}" = 1 ]; then
          printf 'uid=0(root) gid=0(root)\n'
        else
          printf 'uid=2000(shell) gid=2000(shell)\n'
        fi
        ;;
      'su 0 "'*'"')
        inner_command="${command_text#su 0 \"}"
        inner_command="${inner_command%\"}"
        if [ "${MOCK_SU_DIALECT:-join}" = join ] &&
           printf '%s' "$inner_command" | grep -Eq 'helper-transaction-|TRANSACTION_READY|PROBE_READY|--request'; then
          if [[ "$inner_command" =~ (^|[^\\])[\$\`] ]] ||
             [[ "$inner_command" =~ (^|[^\\])\" ]]; then
            printf 'join-style su received shell-active metacharacters before privilege elevation\n' >&2
            exit 1
          fi
        fi
        if printf '%s' "$command_text" | grep -Fq 'id; id' && [ "${MOCK_SU_DIALECT:-join}" = join ]; then
          [ "${MOCK_ROOT:-1}" = 1 ] && printf 'uid=0(root) gid=0(root)\n'
        elif printf '%s' "$command_text" | grep -Fq 'echo LEASE_OK' &&
             printf '%s' "$command_text" | grep -Fq '.hapaneld-helper-manual-upgrade'; then
          [ "${MOCK_MANUAL_LEASE_RENEW:-ok}" = ok ] && printf 'LEASE_OK\n'
        elif printf '%s' "$command_text" | grep -Fq 'inspect_manual_journal'; then
          if [ -f "$STATE_DIR/manual-helper-transaction" ]; then
            printf 'ACTIVE_SYSTEM_TRANSACTION\n'
          else
            printf 'NO_STALE_TRANSACTION\n'
          fi
        elif printf '%s' "$command_text" | grep -Fq '.hapaneld-helper-manual-upgrade' && \
             printf '%s' "$command_text" | grep -Fq '[ ! -f'; then
          [ "${MOCK_MANUAL_STALE:-0}" != 1 ]
        elif printf '%s' "$command_text" | grep -Fq 'touch /system/.rw_probe'; then
          if [ "${MOCK_SYSTEM_WRITABLE:-1}" = 1 ]; then
            printf 'SYSTEM_RW\n'
          else
            printf 'SYSTEM_RO\n'
            if [ "${MOCK_SYSTEMLESS_RUNNER:-1}" = 1 ]; then printf 'SYSTEMLESS_RUNNER\n'; else printf 'NO_SYSTEMLESS_RUNNER\n'; fi
          fi
        elif printf '%s' "$command_text" | grep -Fq 'echo TRANSACTION_READY'; then
          [ "${MOCK_TRANSACTION_TAMPER:-0}" != 1 ] && printf 'TRANSACTION_READY\n'
        elif printf '%s' "$command_text" | grep -Fq 'echo PROBE_READY'; then
          [ "${MOCK_TRANSACTION_TAMPER:-0}" != 1 ] && printf 'PROBE_READY\n'
        elif printf '%s' "$command_text" | grep -Fq 'echo INSTALL_OK' &&
             printf '%s' "$command_text" | grep -Fq '.hapaneld-helper-manual-upgrade'; then
          : > "$STATE_DIR/manual-helper-transaction"
          [ "${MOCK_MANUAL_INSTALL_DELAY:-0}" = 0 ] || /bin/sleep "$MOCK_MANUAL_INSTALL_DELAY"
          printf 'INSTALL_OK\n'
        elif printf '%s' "$command_text" | grep -Fq 'echo COMMIT_OK' &&
             printf '%s' "$command_text" | grep -Fq '.hapaneld-helper-manual-upgrade'; then
          rm -f "$STATE_DIR/manual-helper-transaction"
          printf 'COMMIT_OK\n'
        elif printf '%s' "$command_text" | grep -Fq 'ROLLBACK_RESTARTED' &&
             printf '%s' "$command_text" | grep -Fq '.hapaneld-helper-manual-upgrade'; then
          printf 'ROLLBACK_RESTARTED\n'
        elif printf '%s' "$command_text" | grep -Fq 'ROLLBACK_FINALIZED' &&
             printf '%s' "$command_text" | grep -Fq '.hapaneld-helper-manual-upgrade'; then
          rm -f "$STATE_DIR/manual-helper-transaction"
          printf 'ROLLBACK_FINALIZED\n'
        elif printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*install-(system|systemless)'; then
          if [ "${MOCK_TRANSACTION_BUSY:-0}" = 1 ]; then
            printf 'TRANSACTION_BUSY\n'
          elif [ -f "$STATE_DIR/stale-helper-transaction" ]; then
            case "${MOCK_ACTIVE_TRANSACTION_KIND:-${MOCK_STALE_TRANSACTION_KIND:-system}}" in
              system) [ "${MOCK_ACTIVE_TRANSACTION:-0}" = 1 ] && printf 'ACTIVE_SYSTEM_TRANSACTION\n' || printf 'STALE_SYSTEM_TRANSACTION\n' ;;
              systemless) [ "${MOCK_ACTIVE_TRANSACTION:-0}" = 1 ] && printf 'ACTIVE_SYSTEMLESS_TRANSACTION\n' || printf 'STALE_SYSTEMLESS_TRANSACTION\n' ;;
              both) printf 'MULTIPLE_STALE_TRANSACTIONS\n' ;;
            esac
          else
            [ "${MOCK_HELPER_INSTALL:-ok}" = ok ] && printf 'INSTALL_OK\n'
            [ "${MOCK_HELPER_INSTALL:-ok}" != ok ] || : > "$STATE_DIR/active-helper-transaction"
          fi
        elif printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*finalize-rollback-(system|systemless)'; then
          if [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != finalize ]; then
            printf 'ROLLBACK_FINALIZED\n'
            rm -f "$STATE_DIR/stale-helper-transaction" "$STATE_DIR/active-helper-transaction"
          fi
        elif printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*rollback-(system|systemless)'; then
          if [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != rollback ]; then
            [ "${MOCK_ROLLBACK_RESULT:-ok}" = ok ] && printf 'ROLLBACK_RESTARTED\n'
          fi
        elif printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*commit-(system|systemless)'; then
          if [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != commit ]; then
            if [ "${MOCK_HELPER_COMMIT:-ok}" = ok ] && [ "${MOCK_COMMIT_LIVE_STATE:-TARGET}" = TARGET ]; then
              printf 'COMMIT_OK\n'
              rm -f "$STATE_DIR/stale-helper-transaction" "$STATE_DIR/active-helper-transaction"
            fi
          fi
        elif printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*lease-(system|systemless)'; then
          [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != lease ] && printf 'LEASE_OK\n'
        elif printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*(discover|status)-(system|systemless)'; then
          printf 'JOURNAL_VERSION=1\nJOURNAL_SCOPE=%s\nTRANSACTION_ID=%s\nTARGET_APK_SHA256=%s\nTARGET_BUILD_ID=%s\nTARGET_HELPER_SHA256=%s\nLEASE_BOOT_ID=fixture-boot\nLEASE_UNTIL_UPTIME=999999\nLIVE_STATE=%s\n' \
            "${MOCK_STALE_SCOPE:-APK_HELPER}" "${MOCK_STALE_TRANSACTION_ID:-0123456789abcdef0123456789abcdef}" \
            "${MOCK_STALE_APK_SHA256:?}" \
            "${MOCK_STALE_BUILD_ID:-${MOCK_HELPER_BUILD_ID:?}}" "${MOCK_STALE_HELPER_SHA256:-$(printf '%064d' 0)}" \
            "${MOCK_STALE_LIVE_STATE:-TARGET}"
        elif printf '%s' "$command_text" | grep -Fq 'pidof hapaneld-helper'; then
          [ "${MOCK_HELPER_START:-ok}" = ok ] && printf '4242\n'
        elif printf '%s' "$command_text" | grep -Fq ' --request '; then
          case "$command_text" in
            *' --request PING'*) [ "${MOCK_ROLLBACK_PING:-ok}" = ok ] && printf 'OK\n' ;;
            *' --request COMPANIONCAPS'*)
              [ "${MOCK_HELPER_REQUEST_DELAY:-0}" = 0 ] || /bin/sleep "$MOCK_HELPER_REQUEST_DELAY"
              [ "${MOCK_HELPER_START:-ok}" = ok ] && [ "${MOCK_HELPER_CAPABILITY:-ok}" = ok ] &&
                printf 'COMPANIONCAPS 1 BACKUP RESTORE STATUS JOURNAL\n'
              ;;
            *' --request BUILDID'*)
              [ "${MOCK_HELPER_REQUEST_DELAY:-0}" = 0 ] || /bin/sleep "$MOCK_HELPER_REQUEST_DELAY"
              [ "${MOCK_HELPER_BUILD_ID_MATCH:-ok}" = ok ] && printf 'BUILDID %s\n' "${MOCK_HELPER_BUILD_ID:?}"
              ;;
          esac
        fi
        ;;
      'su 0 sh -c "'*'"')
        if printf '%s' "$command_text" | grep -Fq 'id; id' && [ "${MOCK_SU_DIALECT:-join}" = shc ]; then
          [ "${MOCK_ROOT:-1}" = 1 ] && printf 'uid=0(root) gid=0(root)\n'
        elif printf '%s' "$command_text" | grep -Fq '.hapaneld-helper-manual-upgrade' && \
             printf '%s' "$command_text" | grep -Fq '[ ! -f'; then
          [ "${MOCK_MANUAL_STALE:-0}" != 1 ]
        elif printf '%s' "$command_text" | grep -Fq 'touch /system/.rw_probe'; then
          if [ "${MOCK_SYSTEM_WRITABLE:-1}" = 1 ]; then
            printf 'SYSTEM_RW\n'
          else
            printf 'SYSTEM_RO\n'
            if [ "${MOCK_SYSTEMLESS_RUNNER:-1}" = 1 ]; then printf 'SYSTEMLESS_RUNNER\n'; else printf 'NO_SYSTEMLESS_RUNNER\n'; fi
          fi
        elif printf '%s' "$command_text" | grep -Fq 'echo TRANSACTION_READY'; then
          [ "${MOCK_TRANSACTION_TAMPER:-0}" != 1 ] && printf 'TRANSACTION_READY\n'
        elif printf '%s' "$command_text" | grep -Fq 'echo PROBE_READY'; then
          [ "${MOCK_TRANSACTION_TAMPER:-0}" != 1 ] && printf 'PROBE_READY\n'
        elif printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*install-(system|systemless)'; then
          if [ "${MOCK_TRANSACTION_BUSY:-0}" = 1 ]; then
            printf 'TRANSACTION_BUSY\n'
          elif [ -f "$STATE_DIR/stale-helper-transaction" ]; then
            case "${MOCK_ACTIVE_TRANSACTION_KIND:-${MOCK_STALE_TRANSACTION_KIND:-system}}" in
              system) [ "${MOCK_ACTIVE_TRANSACTION:-0}" = 1 ] && printf 'ACTIVE_SYSTEM_TRANSACTION\n' || printf 'STALE_SYSTEM_TRANSACTION\n' ;;
              systemless) [ "${MOCK_ACTIVE_TRANSACTION:-0}" = 1 ] && printf 'ACTIVE_SYSTEMLESS_TRANSACTION\n' || printf 'STALE_SYSTEMLESS_TRANSACTION\n' ;;
              both) printf 'MULTIPLE_STALE_TRANSACTIONS\n' ;;
            esac
          else
            [ "${MOCK_HELPER_INSTALL:-ok}" = ok ] && printf 'INSTALL_OK\n'
            [ "${MOCK_HELPER_INSTALL:-ok}" != ok ] || : > "$STATE_DIR/active-helper-transaction"
          fi
        elif printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*finalize-rollback-(system|systemless)'; then
          if [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != finalize ]; then
            printf 'ROLLBACK_FINALIZED\n'
            rm -f "$STATE_DIR/stale-helper-transaction" "$STATE_DIR/active-helper-transaction"
          fi
        elif printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*rollback-(system|systemless)'; then
          if [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != rollback ]; then
            [ "${MOCK_ROLLBACK_RESULT:-ok}" = ok ] && printf 'ROLLBACK_RESTARTED\n'
          fi
        elif printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*commit-(system|systemless)'; then
          if [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != commit ]; then
            if [ "${MOCK_HELPER_COMMIT:-ok}" = ok ] && [ "${MOCK_COMMIT_LIVE_STATE:-TARGET}" = TARGET ]; then
              printf 'COMMIT_OK\n'
              rm -f "$STATE_DIR/stale-helper-transaction" "$STATE_DIR/active-helper-transaction"
            fi
          fi
        elif printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*lease-(system|systemless)'; then
          [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != lease ] && printf 'LEASE_OK\n'
        elif printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*(discover|status)-(system|systemless)'; then
          printf 'JOURNAL_VERSION=1\nJOURNAL_SCOPE=%s\nTRANSACTION_ID=%s\nTARGET_APK_SHA256=%s\nTARGET_BUILD_ID=%s\nTARGET_HELPER_SHA256=%s\nLEASE_BOOT_ID=fixture-boot\nLEASE_UNTIL_UPTIME=999999\nLIVE_STATE=%s\n' \
            "${MOCK_STALE_SCOPE:-APK_HELPER}" "${MOCK_STALE_TRANSACTION_ID:-0123456789abcdef0123456789abcdef}" \
            "${MOCK_STALE_APK_SHA256:?}" \
            "${MOCK_STALE_BUILD_ID:-${MOCK_HELPER_BUILD_ID:?}}" "${MOCK_STALE_HELPER_SHA256:-$(printf '%064d' 0)}" \
            "${MOCK_STALE_LIVE_STATE:-TARGET}"
        fi
        ;;
      *)
        if [ "${MOCK_ADB_ROOT:-0}" = 1 ] && printf '%s' "$command_text" | grep -Fq 'touch /system/.rw_probe'; then
          if [ "${MOCK_SYSTEM_WRITABLE:-1}" = 1 ]; then
            printf 'SYSTEM_RW\n'
          else
            printf 'SYSTEM_RO\n'
            if [ "${MOCK_SYSTEMLESS_RUNNER:-1}" = 1 ]; then printf 'SYSTEMLESS_RUNNER\n'; else printf 'NO_SYSTEMLESS_RUNNER\n'; fi
          fi
        elif [ "${MOCK_ADB_ROOT:-0}" = 1 ] && printf '%s' "$command_text" | grep -Fq 'echo TRANSACTION_READY'; then
          [ "${MOCK_TRANSACTION_TAMPER:-0}" != 1 ] && printf 'TRANSACTION_READY\n'
        elif [ "${MOCK_ADB_ROOT:-0}" = 1 ] && printf '%s' "$command_text" | grep -Fq 'echo PROBE_READY'; then
          [ "${MOCK_TRANSACTION_TAMPER:-0}" != 1 ] && printf 'PROBE_READY\n'
        elif [ "${MOCK_ADB_ROOT:-0}" = 1 ] && printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*install-(system|systemless)'; then
          [ "${MOCK_TRANSACTION_BUSY:-0}" = 1 ] && printf 'TRANSACTION_BUSY\n' || printf 'INSTALL_OK\n'
        elif [ "${MOCK_ADB_ROOT:-0}" = 1 ] && printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*commit-(system|systemless)'; then
          [ "${MOCK_HELPER_COMMIT:-ok}" = ok ] &&
            [ "${MOCK_COMMIT_LIVE_STATE:-TARGET}" = TARGET ] && printf 'COMMIT_OK\n'
        elif [ "${MOCK_ADB_ROOT:-0}" = 1 ] && printf '%s' "$command_text" | grep -Eq 'helper-transaction-[0-9a-f]+.*lease-(system|systemless)'; then
          [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != lease ] && printf 'LEASE_OK\n'
        fi
        ;;
    esac
    ;;
  *)
    ;;
esac
