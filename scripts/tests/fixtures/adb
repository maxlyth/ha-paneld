#!/usr/bin/env bash
set -u

printf 'adb %s\n' "$*" >> "${MOCK_CALL_LOG:?MOCK_CALL_LOG is required}"
STATE_DIR="${MOCK_STATE_DIR:-$(dirname "$MOCK_CALL_LOG")}"
# A clean panel has no package at all. Without this the fixture would silently re-create one and a
# genuine first installation could never be modelled.
if [ "${MOCK_NO_INSTALLED_PACKAGE:-0}" != 1 ]; then
  [ -f "$STATE_DIR/installed-apk" ] || printf 'previous installed apk\n' > "$STATE_DIR/installed-apk"
fi

# adb-root is a TRANSITION, not a constant: MOCK_ADB_ROOT=1 models a panel already running adbd as
# root; the escalates* modes model a userdebug panel that answers uid=2000 until the `root` verb is
# called and only then changes state — the sequence the capture gate's escalation contracts need.
# escalates: `id` answers uid=0 after the verb. escalates_then_hang: the probe never answers after
# the verb. escalates_then_drop: the transport dies after the verb.
adb_root_active() {
  [ "${MOCK_ADB_ROOT:-0}" = 1 ] && return 0
  [ "${MOCK_ADB_ROOT:-0}" = escalates ] && [ -f "$STATE_DIR/adb-root-escalated" ]
}

# Package presence and package-manager responsiveness are INDEPENDENT axes, because Android reports
# them through one exit status and the provisioner has to tell them apart (#89). MOCK_PM_PATH models
# the ha-paneld package; MOCK_PM_LIVENESS models the package manager itself, answering for framework
# packages that exist on every build. A clean panel is MOCK_PM_PATH=fail with MOCK_PM_LIVENESS=ok:
# the query "fails" precisely because the package is not installed.
#   ok      resolves to a path            fail  answers nothing, exit 1
#   absent  answers, names no path, exit 0  hang  never answers, so the caller's deadline expires
# Answer the nonce-marked package probe. Three INDEPENDENT axes, because conflating them is exactly
# how this defect survived two reviews:
#   MOCK_PM_PROBE      how the OBSERVATION as a whole fails
#     ok / truncated (END lost) / stale_nonce / out_of_order / hang / complete_then_fail
#   MOCK_PM_PATH       what the target child says      (ok / absent / fail / empty_path / relative_path)
#   MOCK_PM_TARGET_RC  what the target child's status is when it did NOT answer normally, e.g. 137 for
#                      a killed child or 2 for an internal error. This is the axis that was missing:
#                      the outer shell completes perfectly while only the child inside it dies.
#   MOCK_PM_LIVENESS / MOCK_PM_LIVE_RC   the same two axes for the framework query.
pm_marked_probe_reply() {
  local text="$1" nonce other trc lrc
  nonce="${text#*HAPANELD_PKG_BEGIN:}"
  nonce="${nonce%%[!0-9a-f]*}"
  other="${MOCK_PM_PROBE:-ok}"
  # MOCK_APK_QUERY models a package manager that stops answering AFTER a mutation is attempted. It
  # must reach this probe too, otherwise the fixture would claim a confident verdict from a package
  # manager it is simultaneously modelling as unanswerable.
  if [ "${MOCK_APK_QUERY:-ok}" != ok ] && [ -f "$STATE_DIR/apk-install-attempted" ]; then
    other=truncated
  fi
  # MOCK_PM_VANISH_AFTER models the package disappearing partway through a run: the first N marked
  # probes resolve it, later ones do not. It is what a reset target being uninstalled mid-run looks
  # like, which is the only way to reach the post-confirmation re-check's absent verdict.
  if [ -n "${MOCK_PM_VANISH_AFTER:-}" ]; then
    printf 'x' >> "$STATE_DIR/pm-probe-count"
    if [ "$(wc -c < "$STATE_DIR/pm-probe-count")" -gt "$MOCK_PM_VANISH_AFTER" ]; then
      MOCK_PM_PATH=absent
    fi
  fi
  if [ "$other" = hang ]; then
    [ -z "${MOCK_PM_PROBE_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_PM_PROBE_PID_FILE"
    trap 'exit 143' TERM INT
    while :; do /bin/sleep 1; done
  fi
  [ "$other" != stale_nonce ] || nonce="0123456789abcdef0123456789abcdef"
  # A real `pm path` exits 0 when it names a path and non-zero when the package is simply absent.
  case "${MOCK_PM_PATH:-ok}" in
    ok) trc=0 ;;
    *)  trc=1 ;;
  esac
  [ -z "${MOCK_PM_TARGET_RC:-}" ] || trc="$MOCK_PM_TARGET_RC"
  case "${MOCK_PM_LIVENESS:-ok}" in
    ok) lrc=0 ;;
    *)  lrc=1 ;;
  esac
  [ -z "${MOCK_PM_LIVE_RC:-}" ] || lrc="$MOCK_PM_LIVE_RC"
  if [ "$other" = out_of_order ]; then
    printf 'HAPANELD_PKG_TARGET:%s:%s\n' "$nonce" "$trc"
    printf 'HAPANELD_PKG_BEGIN:%s\n' "$nonce"
    printf 'HAPANELD_PKG_LIVE:%s:%s\n' "$nonce" "$lrc"
    printf 'HAPANELD_PKG_END:%s\n' "$nonce"
    exit 0
  fi
  printf 'HAPANELD_PKG_BEGIN:%s\n' "$nonce"
  pm_marked_paths "${MOCK_PM_PATH:-ok}" 'package:/data/app/io.github.maxlyth.hapaneld/base.apk' \
    "$([ -f "$STATE_DIR/installed-apk" ] && echo yes || echo no)"
  printf 'HAPANELD_PKG_TARGET:%s:%s\n' "$nonce" "$trc"
  pm_marked_paths "${MOCK_PM_LIVENESS:-ok}" 'package:/system/framework/framework-res.apk' yes
  printf 'HAPANELD_PKG_LIVE:%s:%s\n' "$nonce" "$lrc"
  # Complete, nonce-bound output from a command that nonetheless failed. The markers alone cannot
  # catch this, so it is what makes the caller's exit-status check load-bearing rather than redundant.
  [ "$other" != truncated ] || exit 0
  printf 'HAPANELD_PKG_END:%s\n' "$nonce"
  [ "$other" != complete_then_fail ] || exit 1
  exit 0
}

# Emit the path lines one `pm path` would print inside the marked run. `empty_path` models a
# truncated line — a bare `package:` with nothing after it, which must never count as an answer.
pm_marked_paths() {
  local mode="$1" path="$2" installed="$3"
  case "$mode" in
    ok) [ "$installed" = yes ] && printf '%s\n' "$path" ;;
    empty_path) printf 'package:\n' ;;
    relative_path) printf 'package:data/app/base.apk\n' ;;
    absent|fail) ;;
    *) ;;
  esac
  return 0
}

pm_query_reply() {
  local mode="$1" path="$2" pid_file="${3:-}"
  case "$mode" in
    ok) printf '%s\n' "$path"; exit 0 ;;
    absent) exit 0 ;;
    fail) exit 1 ;;
    hang)
      [ -z "$pid_file" ] || printf '%s\n' "$$" > "$pid_file"
      trap 'exit 143' TERM INT
      while :; do /bin/sleep 1; done
      ;;
    *) printf 'mock adb: unknown pm query mode %s\n' "$mode" >&2; exit 64 ;;
  esac
}

mark_hapaneld_stopped() {
  local apk_path="$1"
  if [ "${MOCK_STOPPED_STATE:-0}" = 1 ] && [[ "$apk_path" != */shizuku.apk ]]; then
    : > "$STATE_DIR/package-stopped"
  fi
}

emit_system_layout_probe() {
  if [ "${MOCK_SYSTEM_WRITABLE:-1}" = 1 ]; then
    printf 'SYSTEM_RW\n'
    if [ "${MOCK_DEVICE_AWK:-present}" = missing ] &&
       printf '%s\n' "$command_text" | grep -Eq 'df[^|]*/system[^|]*\|[[:space:]]*awk'; then
      printf 'SYSTEM_CAPACITY_UNKNOWN\n'
    elif ! printf '%s\n' "$command_text" | grep -Fq 'df -P -k /system'; then
      printf 'SYSTEM_CAPACITY_UNKNOWN\n'
    else
      case "${MOCK_SYSTEM_CAPACITY:-valid}" in
        valid) printf 'SYSTEM_AVAIL_KB=%s\n' "${MOCK_SYSTEM_AVAIL_KB:-1048576}" ;;
        malformed|ambiguous|missing|missing-df|missing-sed) printf 'SYSTEM_CAPACITY_UNKNOWN\n' ;;
      esac
    fi
  else
    printf 'SYSTEM_RO\n'
    if [ "${MOCK_SYSTEMLESS_RUNNER:-1}" = 1 ]; then printf 'SYSTEMLESS_RUNNER\n'; else printf 'NO_SYSTEMLESS_RUNNER\n'; fi
  fi
  case "${MOCK_VENDOR_RC_STATE:-missing}" in
    missing) ;;
    managed) printf 'VENDOR_RC_MANAGED\n' ;;
    unexpected) printf 'VENDOR_RC_UNEXPECTED\n' ;;
  esac
}

# The database capture is ONE pushed transaction script. The fixture does not emulate it — it saves
# the pushed bytes and EXECUTES them for real in a path-rewritten sandbox with stub sqlite3/dumpsys
# on PATH, so every contract observes the shipped script's own semantics. A model can agree with a
# test and disagree with production; an executed script cannot.
DB_TXN_SANDBOX="$STATE_DIR/db-txn-sandbox"
prepare_db_txn_sandbox() {
  [ -d "$DB_TXN_SANDBOX/bin" ] && return 0
  mkdir -p "$DB_TXN_SANDBOX/data/local/tmp" "$DB_TXN_SANDBOX/data/data/io.github.maxlyth.hapaneld/databases" "$DB_TXN_SANDBOX/bin"
  canonical_db="$DB_TXN_SANDBOX/data/data/io.github.maxlyth.hapaneld/databases/ha-paneld.db"
  rm -f "$canonical_db"
  "${HAPANELD_HOST_SQLITE3:-sqlite3}" "$canonical_db" >/dev/null <<'SQL'
PRAGMA journal_mode=WAL;
PRAGMA user_version=9;
CREATE TABLE app_state (key TEXT PRIMARY KEY, value TEXT NOT NULL);
INSERT INTO app_state VALUES
 ('fixture-1','1'),('fixture-2','2'),('fixture-3','3'),('fixture-4','4'),
 ('fixture-5','5'),('fixture-6','6'),('fixture-7','7');
SQL
  "${HAPANELD_HOST_SQLITE3:-sqlite3}" "$canonical_db" 'PRAGMA wal_checkpoint(TRUNCATE);' >/dev/null
  # A cleanly present zero-byte WAL is a NORMAL source state and must never affect a .backup capture.
  : > "$DB_TXN_SANDBOX/data/data/io.github.maxlyth.hapaneld/databases/ha-paneld.db-wal"
  cat > "$DB_TXN_SANDBOX/bin/sqlite3" <<'STUB'
#!/bin/bash
db="$1"; shift; op="$*"
case "$op" in
  *.backup*)
    [ -z "${MOCK_CALL_LOG:-}" ] || printf 'sqlite3 .backup\n' >> "$MOCK_CALL_LOG"
    [ "${MOCK_DB_TXN:-ok}" = backup_fail ] && exit 1
    dest="${op#*.backup \'}"; dest="${dest%\'*}"
    cp "$db" "$dest" || exit 1
    if [ "${MOCK_DB_TXN:-ok}" = backup_empty ]; then : > "$dest"; fi
    ;;
  *integrity_check*)
    if [ "${MOCK_DB_TXN:-ok}" = integrity_bad ]; then echo '*** in database main ***'; else echo ok; fi ;;
  *'count(*) FROM app_state'*) echo "${MOCK_DB_DEVICE_ROWS:-7}" ;;
  *user_version*) echo "${MOCK_DB_DEVICE_USER_VERSION:-9}" ;;
  *) exit 1 ;;
esac
exit 0
STUB
  cat > "$DB_TXN_SANDBOX/bin/dumpsys" <<'STUB'
#!/bin/bash
[ "${MOCK_DB_DEVICE_VCODE:-513}" = absent ] && exit 0
if [ "${MOCK_DB_TXN:-ok}" = provenance_race ]; then
  # Every dumpsys call answers a different build: the capture's before/after reads can never agree.
  count_file="${MOCK_STATE_DIR:?}/db-txn-vcode-count"
  count=$(( $(cat "$count_file" 2>/dev/null || echo 0) + 1 ))
  printf '%s' "$count" > "$count_file"
  printf '    versionCode=%s minSdk=26 targetSdk=35\n' $((500 + count))
else
  printf '    versionCode=%s minSdk=26 targetSdk=35\n' "${MOCK_DB_DEVICE_VCODE:-513}"
fi
printf '    versionName=0.9.6-test\n'
STUB
  cat > "$DB_TXN_SANDBOX/bin/sha256sum" <<'STUB'
#!/bin/bash
[ "${MOCK_DB_TXN:-ok}" = no_device_digest ] && exit 1
exec /usr/bin/sha256sum "$@"
STUB
  cat > "$DB_TXN_SANDBOX/bin/toybox" <<'STUB'
#!/bin/bash
[ "$1" = sha256sum ] || exit 1
[ "${MOCK_DB_TXN:-ok}" = no_device_digest ] && exit 1
shift
exec /usr/bin/sha256sum "$@"
STUB
  cat > "$DB_TXN_SANDBOX/bin/busybox" <<'STUB'
#!/bin/bash
[ "$1" = sha256sum ] || exit 1
[ "${MOCK_DB_TXN:-ok}" = no_device_digest ] && exit 1
shift
exec /usr/bin/sha256sum "$@"
STUB
  chmod 755 "$DB_TXN_SANDBOX/bin/sha256sum" "$DB_TXN_SANDBOX/bin/toybox" "$DB_TXN_SANDBOX/bin/busybox"
  chmod 755 "$DB_TXN_SANDBOX/bin/sqlite3" "$DB_TXN_SANDBOX/bin/dumpsys"
}

run_db_txn_script() {
  prepare_db_txn_sandbox
  [ -s "$STATE_DIR/db-txn-script.$ADB_TARGET" ] || { echo 'SNAPTXN_FAIL=script_missing'; return 1; }
  if [ "${MOCK_DB_TXN:-ok}" = stage_collision ]; then
    # Another owner already holds the exact staging path this transaction wants: pre-create it with
    # a marker file, so the survival of that marker proves the loser removed nothing.
    collision_stage="$(grep -oE '/data/local/tmp/\.hapaneld-db-txn\.[0-9a-f]+' "$STATE_DIR/db-txn-script.$ADB_TARGET" | head -1)"
    mkdir -p "$DB_TXN_SANDBOX${collision_stage}"
    : > "$DB_TXN_SANDBOX${collision_stage}/winner-in-flight"
  fi
  sed -e "s|/data/|$DB_TXN_SANDBOX/data/|g" -e "s|/system/bin/sqlite3|$DB_TXN_SANDBOX/bin/sqlite3|g" \
    "$STATE_DIR/db-txn-script.$ADB_TARGET" > "$STATE_DIR/db-txn-script.runnable.$ADB_TARGET"
  PATH="$DB_TXN_SANDBOX/bin:$PATH" bash "$STATE_DIR/db-txn-script.runnable.$ADB_TARGET"
}

handle_db_txn_command() {
  local text="$1"
  case "$text" in
    *sha256sum*.hapaneld-db-txn.*-script*)
      [ "${MOCK_DB_TXN:-ok}" != panel_hash_transport ] || return 1
      prepare_db_txn_sandbox
      if [ "${MOCK_DB_TXN:-ok}" = script_tamper ]; then
        printf '%064d  tampered\n' 1
      else
        /usr/bin/sha256sum "$STATE_DIR/db-txn-script.$ADB_TARGET" 2>/dev/null | awk '{print $1"  script"}'
      fi
      return 0 ;;
    *'sh /data/local/tmp/.hapaneld-db-txn.'*-script*)
      run_db_txn_script
      return 0 ;;
    *.hapaneld-db-txn.*HAPANELD_STALE_PRESENT*)
      case "${MOCK_DB_CLEANUP:-ok}" in
        unverifiable) return 1 ;;
        retained) printf 'HAPANELD_STALE_PRESENT\n' ;;
        *)
          # Answer from sandbox truth for the EXACT path the probe names — absence is asserted by
          # what the executed cleanup really left, and one run's leftovers never answer for another.
          probed="$(printf '%s' "$text" | grep -oE '/data/local/tmp/\.hapaneld-db-txn\.[0-9a-f]+' | head -1)"
          if [ -n "$probed" ] && [ -e "$DB_TXN_SANDBOX/data/local/tmp/${probed#/data/local/tmp/}" ]; then
            printf 'HAPANELD_STALE_PRESENT\n'
          else
            printf 'HAPANELD_STALE_ABSENT\n'
          fi ;;
      esac
      return 0 ;;
    *'rm -'*.hapaneld-db-txn.*)
      # block models the post-publication cleanup wedging on a failing transport, so a test can
      # deliver the operator's Ctrl-C exactly inside that window and observe what survives it. It
      # blocks only the FIRST cleanup: the signal path retries the same removal from its handler,
      # and blocking that retry too would wedge the handler the test is trying to observe.
      if [ "${MOCK_DB_CLEANUP:-ok}" = block ] && [ ! -f "$STATE_DIR/db-cleanup-blocked-once" ]; then
        : > "$STATE_DIR/db-cleanup-blocked-once"
        [ -z "${MOCK_DB_CLEANUP_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_DB_CLEANUP_PID_FILE"
        exec /bin/sleep "${MOCK_DB_CLEANUP_BLOCK_SECONDS:-30}"
      fi
      if [ "${MOCK_DB_CLEANUP:-ok}" = ok ]; then
        rm -rf "$DB_TXN_SANDBOX/data/local/tmp"/.hapaneld-db-txn.* 2>/dev/null
      fi
      return 0 ;;
  esac
  return 1
}

# Model the panel's id-named staging as real files. The journal was modelled as boolean flag files
# that the harness reset before every run, so no test could observe staging carried between runs —
# that blind spot is why Issue #76's accumulation was invisible to a green suite. Both halves of a
# run's staging are modelled: the protected transaction record in /data/adb/hapaneld AND the pushed
# bundle in /data/local/tmp, flattened by basename into one directory.
DEVICE_ADB_DIR="$STATE_DIR/device-data-adb-hapaneld"

device_adb_paths() {
  printf '%s' "$1" \
    | grep -oE '/data/(adb/hapaneld/\.helper-(transaction|probe)|local/tmp/hapaneld-helper)-[0-9a-f]+(-[0-9a-f]+)?(\.[a-z]+)?' \
    || true
}

model_device_adb_dir() {
  local text="$1" path
  case "$text" in
    *'echo TRANSACTION_READY'*|*'echo PROBE_READY'*)
      [ "${MOCK_TRANSACTION_TAMPER:-0}" != 1 ] || return 0
      mkdir -p "$DEVICE_ADB_DIR" || return 0
      for path in $(device_adb_paths "$text"); do
        : > "$DEVICE_ADB_DIR/${path##*/}"
      done
      # The promotion command names both <record>.new and <record>; its mv -f leaves only the
      # final record, so a phantom .new must not survive in the model.
      rm -f "$DEVICE_ADB_DIR"/.helper-transaction-*.new
      return 0
      ;;
  esac
  case "$text" in
    *'rm -f '*)
      for path in $(device_adb_paths "$text"); do
        rm -f "$DEVICE_ADB_DIR/${path##*/}"
      done
      # A glob in a privileged rm expands on the panel; expand it in the model too, or a too-broad
      # wildcard cleanup would sail past the identity-scoping survival contracts.
      for pattern in $(printf '%s' "$text" | grep -oE '/data/(adb/hapaneld/\.helper-[a-z]+|local/tmp/hapaneld-helper)-[0-9a-f-]*\*' || true); do
        base="${pattern##*/}"
        rm -f "$DEVICE_ADB_DIR/${base%\*}"* 2>/dev/null || true
      done
      ;;
  esac
}

if [ "${1:-}" = "connect" ]; then
  exit 0
fi

if [ "${1:-}" = "devices" ]; then
  # hang_after_escalation models adb wedging in the reconnect window the `root` verb opened, so a
  # test can prove the escalation's aggregate deadline instead of the per-step adb deadline.
  if [ "${MOCK_ADB_DEVICES:-ok}" = hang_after_escalation ] && [ -f "$STATE_DIR/adb-root-escalated" ]; then
    trap 'exit 143' TERM INT
    while :; do /bin/sleep 1; done
  fi
  state="${MOCK_ADB_STATE:-device}"
  printf 'List of devices attached\n'
  if [ "$state" != "missing" ]; then
    for target in ${MOCK_TARGETS:-${MOCK_TARGET:-panel.test:5555}}; do printf '%s\t%s\n' "$target" "$state"; done
  fi
  exit 0
fi

ADB_TARGET=""
if [ "${1:-}" = "-s" ]; then
  ADB_TARGET="${2:-}"
  shift 2
fi

VERIFY_GRANTS_OK=1
if [ "${MOCK_VERIFY:-ok}" = fail ] || \
   { [ -n "${MOCK_VERIFY_FAIL_HOST:-}" ] && \
     { [ "$ADB_TARGET" = "$MOCK_VERIFY_FAIL_HOST" ] || [ "$ADB_TARGET" = "$MOCK_VERIFY_FAIL_HOST:5555" ]; }; }; then
  VERIFY_GRANTS_OK=0
fi

case "${1:-}" in
  root)
    case "${MOCK_ADB_ROOT:-0}" in
      escalates|escalates_then_hang|escalates_then_drop)
        : > "$STATE_DIR/adb-root-escalated" ;;
      *)
        [ "${MOCK_ROOT:-1}" = 1 ] ;;
    esac
    ;;
  push)
    # A pushed staged input becomes a real modelled file, so its later reclamation is observable.
    for pushed in "$@"; do
      case "$pushed" in
        /data/local/tmp/hapaneld-helper-*)
          mkdir -p "$DEVICE_ADB_DIR" && : > "$DEVICE_ADB_DIR/${pushed##*/}" ;;
      esac
    done
    # The capture transaction script's exact pushed bytes are saved so the fixture can hash and
    # EXECUTE what production actually sent, not a paraphrase of it.
    case "${3:-}" in
      /data/local/tmp/.hapaneld-db-txn.*-script)
        [ "${MOCK_DB_TXN:-ok}" = push_fail ] && exit 1
        cp "${2:?push source missing}" "$STATE_DIR/db-txn-script.$ADB_TARGET" ;;
    esac
    ;;
  pull)
    # MOCK_APK_QUERY=fail models a package manager that became unanswerable at the install-outcome
    # moment; queries before any install attempt still succeed, so pre-mutation stages (the database
    # capture included) observe the panel as it was.
    if [ "${MOCK_APK_QUERY:-ok}" != ok ] && [ -f "$STATE_DIR/apk-install-attempted" ]; then exit 1; fi
    case "${2:-}" in
      *.hapaneld-db-txn.*/ha-paneld.db)
        [ "${MOCK_DB_TXN:-ok}" = pull_fail ] && exit 1
        # The pulled bytes come from the sandbox the executed script actually wrote, so a transfer
        # contract observes the real captured file, not a manufactured stand-in.
        cp "$DB_TXN_SANDBOX/data/local/tmp/${2#/data/local/tmp/}" "${3:?pull destination missing}" 2>/dev/null || exit 1
        if [ "${MOCK_DB_TXN:-ok}" = pull_truncate ]; then printf 'short' > "$3"; fi
        ;;
      *) cp "$STATE_DIR/installed-apk" "${3:?pull destination missing}" ;;
    esac
    ;;
  exec-out)
    shift
    command_text="$*"
    case "$command_text" in
      *'cat /data/data/io.github.maxlyth.hapaneld/databases/ha-paneld.db'*)
        if [ "${MOCK_DIRECT_COPY:-ok}" = block ]; then
          [ -z "${MOCK_DIRECT_COPY_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_DIRECT_COPY_PID_FILE"
          exec /bin/sleep "${MOCK_DIRECT_COPY_BLOCK_SECONDS:-30}"
        fi
        [ "${MOCK_DIRECT_COPY:-ok}" = ok ] || exit 1
        prepare_db_txn_sandbox
        cat "$DB_TXN_SANDBOX/data/data/io.github.maxlyth.hapaneld/databases/ha-paneld.db"
        ;;
      *) exit 1 ;;
    esac
    ;;
  install)
    : > "$STATE_DIR/apk-install-attempted"
    if [[ "${!#}" == */shizuku.apk ]] && [ "${MOCK_SHIZUKU_INSTALL:-ok}" = block ]; then
      [ -z "${MOCK_SHIZUKU_INSTALL_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_SHIZUKU_INSTALL_PID_FILE"
      trap 'exit 143' TERM INT
      while :; do /bin/sleep 1; done
    elif [ "${MOCK_APK_INSTALL:-ok}" = block ] || [ "${MOCK_APK_INSTALL:-ok}" = ignore_term ]; then
      [ -z "${MOCK_APK_INSTALL_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_APK_INSTALL_PID_FILE"
      if [ "${MOCK_APK_INSTALL:-ok}" = ignore_term ]; then trap '' TERM; else trap 'exit 143' TERM; fi
      trap 'exit 130' INT
      while :; do /bin/sleep 1; done
    elif [ "${MOCK_APK_INSTALL:-ok}" = grant_flag_unsupported ] && [[ " $* " == *" -g "* ]]; then
      printf 'Error: Unknown option: -g\n' >&2
      exit 1
    elif [ "${MOCK_APK_INSTALL:-ok}" = grant_flag_unsupported ]; then
      cp "${!#}" "$STATE_DIR/installed-apk"
      mark_hapaneld_stopped "${!#}"
      printf 'Success\n'
    elif [ "${MOCK_APK_INSTALL:-ok}" = ok ]; then
      cp "${!#}" "$STATE_DIR/installed-apk"
      mark_hapaneld_stopped "${!#}"
      printf 'Success\n'
    elif [ "${MOCK_APK_INSTALL:-ok}" = ambiguous_commit ]; then
      cp "${!#}" "$STATE_DIR/installed-apk"
      mark_hapaneld_stopped "${!#}"
      printf 'error: transport closed after install request\n' >&2
      exit 1
    else
      printf '%s\n' "${MOCK_APK_INSTALL_OUTPUT:-Failure [INSTALL_FAILED_INSUFFICIENT_STORAGE]}"
      exit 1
    fi
    ;;
  disconnect)
    ;;
  shell)
    shift
    command_text="$*"
    # Reclamation transport failure: the run's own outcome must not change, and the notice must be
    # honest about what happens next (the panel-side sweep removes the leftovers).
    if [ "${MOCK_STAGING_CLEANUP:-ok}" = fail ] &&
       printf '%s' "$command_text" | grep -Eq 'rm -f[^|]*(hapaneld-helper-[0-9a-f]{32}|\.helper-transaction-)'; then
      printf 'rm: permission denied\n' >&2
      exit 1
    fi
    model_device_adb_dir "$command_text"
    # Database-capture traffic is dialect-independent: intercept it whether it arrives bare
    # (SU_FORM=shell on adb-root panels) or su-wrapped, before any other dispatch.
    case "$command_text" in
      *'.hapaneld-db-txn.'*)
        handle_db_txn_command "$command_text"
        exit $? ;;
    esac
